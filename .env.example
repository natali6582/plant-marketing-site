# Make.com custom-webhook URL that receives lead-form submissions
# and creates the monday item. See config.md.
PUBLIC_LEAD_WEBHOOK_URL=

# Make.com custom-webhook URL that receives community join requests.
# Deliberately separate from the lead webhook, so join requests never mix
# into the sales pipeline. Empty = the community form shows its failure
# message and sends nothing.
PUBLIC_COMMUNITY_WEBHOOK_URL=

# Builds the knowledge hub (/knowledge/). Anything other than the exact string
# "true" and the section produces no pages at all — no hub, no tracks, no
# articles, and no /knowledge/ entry in the sitemap.
#
# It is a BUILD variable, not a runtime one. On Cloudflare it belongs in the
# Worker's build settings; setting it anywhere else has no effect, because the
# site is fully static and the flag is read while the pages are generated.
#
# Note before switching it on in production: every article is currently
# draft: true, and drafts render only when this flag is on — each with a
# visible "טיוטה" banner and a noindex. Turning this on today publishes those
# banners to real visitors. The order is: verify the sources, set draft: false,
# then set this.
KNOWLEDGE_ENABLED=
