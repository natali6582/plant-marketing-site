# Make.com custom-webhook URL that receives lead-form submissions
# and creates the monday item. See config.md.
PUBLIC_LEAD_WEBHOOK_URL=

# Make.com custom-webhook URL that receives community join requests.
# Deliberately separate from the lead webhook, so join requests never mix
# into the sales pipeline. Empty = the community form shows its failure
# message and sends nothing.
PUBLIC_COMMUNITY_WEBHOOK_URL=

# Review switch. The exact value "true" builds the complete knowledge hub only
# for a non-main Workers Build (or npm run dev locally). Drafts are included,
# carry a visible banner, and every knowledge page receives noindex.
KNOWLEDGE_ENABLED=

# Public switch. The exact value "true" builds /knowledge/ on main, but includes
# only articles with draft: false and omits tier-0 figures. This is deliberately
# separate from review. Both values are BUILD variables read during generation,
# so changing either one requires a new build.
KNOWLEDGE_PUBLIC=
