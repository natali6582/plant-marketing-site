# Make.com custom-webhook URL that receives lead-form submissions
# and creates the monday item. See config.md.
PUBLIC_LEAD_WEBHOOK_URL=

# Make.com custom-webhook URL that receives community join requests.
# Deliberately separate from the lead webhook, so join requests never mix
# into the sales pipeline. Empty = the community form shows its failure
# message and sends nothing.
PUBLIC_COMMUNITY_WEBHOOK_URL=

# Management-demo switch. The exact value "true" builds the complete knowledge
# hub in any environment, including main. All articles and tier-0 figures are
# included without visible editorial-state labels; every knowledge page remains
# noindex. Turn this off before connecting a public custom domain.
KNOWLEDGE_ENABLED=

# Curated-public switch for a future custom-domain launch. The exact value "true"
# builds /knowledge/ with only articles whose draft field is false and omits
# tier-0 figures. Demo mode takes precedence when both switches are true. Both
# values are BUILD variables, so changing either one requires a new build.
KNOWLEDGE_PUBLIC=
