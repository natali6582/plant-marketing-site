---
/*
  Home audience selector (#audiences).

  Three cards, one per audience, each a single <a> so the whole card is the
  target — not a card with a link inside it. Focus is the site's global
  :focus-visible ring; no per-component focus styling.

  D3 = KEEP: the advantages marquee stays above this section, so the page
  reads hero → marquee → selector. D7 = one component: PR B inserts the
  aria-hidden "field of view" SVG into the slot marked below and the cards
  sit over it. The slot is a comment, not a placeholder image — nothing
  renders there until that PR.
*/
import { audiences } from '../data/audiences';
---

<section id="audiences" class="band bg-ink-50" aria-labelledby="audiences-title">
  <div class="mx-auto max-w-6xl px-4">
    <h2 id="audiences-title" class="reveal-lines text-center text-3xl font-bold text-ink-900">
      איך אתם רואים את הלקוח היום?
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-center leading-relaxed text-ink-700">
      שלוש נקודות מבט על אותו לקוח — ו־<span class="ltr">Plan-T</span> מתאימה את עצמה לכל אחת מהן.
    </p>

    <!-- PR B: the aria-hidden concentric SVG backdrop is inserted here, behind
         the grid below. Ring positions must clear the cards at sm/md/lg. -->

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        audiences.map((audience) => (
          <a
            href={audience.href}
            class="reveal card-lift group flex flex-col rounded-2xl border border-brand-100 bg-white p-6 shadow-sm"
          >
            <h3 class="text-xl font-bold text-ink-900">{audience.name}</h3>
            <p class="mt-2 flex-1 leading-relaxed text-ink-700">{audience.line}</p>
            <span
              class="mt-4 text-2xl text-brand-600 transition-transform group-hover:-translate-x-1"
              aria-hidden="true"
            >
              ←
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
