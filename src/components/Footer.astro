---
const year = new Date().getFullYear();
---

<footer class="border-t border-brand-100 bg-brand-950 text-brand-100">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
    <div>
      <p class="text-lg font-black text-white"><span class="ltr">Plan-T</span></p>
      <p class="mt-2 max-w-xs text-sm leading-relaxed">
        פלטפורמה ליועצים פיננסיים, סוכני ביטוח ויועצים פנסיוניים בישראל.
      </p>
    </div>
    <nav aria-label="קישורי פוטר" class="grid grid-cols-2 gap-2 text-sm">
      <a href="/product/" class="hover:text-white hover:underline">Plan-t AI</a>
      <a href="/solutions/" class="hover:text-white hover:underline">פתרונות לפי תפקיד</a>
      <a href="/webinar/" class="hover:text-white hover:underline">וובינר</a>
      <a href="/about/" class="hover:text-white hover:underline">אודות</a>
      <a href="/contact/" class="hover:text-white hover:underline">יצירת קשר</a>
      <a href="/privacy/" class="hover:text-white hover:underline">מדיניות פרטיות</a>
      <a href="/accessibility/" class="hover:text-white hover:underline">הצהרת נגישות</a>
    </nav>
    <div class="text-sm">
      <p class="font-bold text-white">יצירת קשר</p>
      <p class="mt-2">
        דוא״ל: <a href="mailto:info@plan-t.co.il" class="ltr underline hover:text-white">info@plan-t.co.il</a>
      </p>
      <p class="mt-1">
        טלפון: <a href="tel:+97230000000" class="ltr underline hover:text-white">03-000-0000</a>&#32;<span class="text-brand-300">[TBD — מספר אמיתי]</span>
      </p>
    </div>
  </div>
  <div class="border-t border-brand-800">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-brand-300">
      © <span class="ltr">{year}</span> Plan-T. כל הזכויות שמורות.
    </p>
  </div>
</footer>
