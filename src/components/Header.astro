---
const { minimal = false } = Astro.props;
const links = [
  { href: '/product/', label: 'הפלטפורמה' },
  { href: '/solutions/', label: 'תהליכי עבודה' },
  { href: '/about/', label: 'אודות' },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-brand-100 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-xl font-black text-ink-900" aria-label="Plan-T — דף הבית">
      <!-- The Plan-T mark: circle with the T in negative space. Geometry and
           colours taken from the official logo on plan-t.org.il. -->
      <svg width="30" height="30" viewBox="0 0 768 768" fill="none" aria-hidden="true">
        <clipPath id="plant-mark"><circle cx="384" cy="384" r="384" /></clipPath>
        <g clip-path="url(#plant-mark)">
          <rect x="0" y="0" width="768" height="319" fill="#101228" />
          <rect x="0" y="407" width="340" height="361" fill="#249FDA" />
          <rect x="428" y="407" width="340" height="361" fill="#8DC63F" />
        </g>
      </svg>
      <span class="ltr">Plan-T</span>
    </a>

    {!minimal && (
    <nav aria-label="ניווט ראשי" class="hidden items-center gap-6 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={current === link.href ? 'page' : undefined}
            class:list={[
              'text-sm font-medium transition-colors hover:text-brand-600',
              current === link.href ? 'text-brand-700 underline underline-offset-8' : 'text-ink-700',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/contact/"
        class="rounded-full bg-brand-700 px-5 py-2 text-sm font-bold text-white transition-colors hover:bg-brand-600"
      >
        תיאום הדגמה
      </a>
    </nav>
    )}

    {!minimal && (
    <details class="relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center rounded-lg p-2 text-brand-800 [&::-webkit-details-marker]:hidden" aria-label="תפריט">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <nav aria-label="ניווט נייד" class="absolute start-auto end-0 mt-2 flex w-56 flex-col gap-1 rounded-xl border border-brand-100 bg-white p-3 shadow-lg">
        {
          links.map((link) => (
            <a href={link.href} class="rounded-lg px-3 py-2 text-sm font-medium text-ink-700 hover:bg-brand-50">
              {link.label}
            </a>
          ))
        }
        <a href="/contact/" class="mt-1 rounded-lg bg-brand-700 px-3 py-2 text-center text-sm font-bold text-white">
          תיאום הדגמה
        </a>
      </nav>
    </details>
    )}
  </div>
</header>
