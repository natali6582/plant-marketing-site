---
/*
  Infinite horizontal marquee — 40 px/s, linear, seamless at any width.

  The behaviour is reproduced from the Orion study (motion-plan.md); none of
  their code, markup or styling is used.

  Three things were wrong before and all three are fixed here.

  It travelled the wrong way. The track is width:max-content inside an RTL
  container, so it anchors to the container's right edge and every extra copy
  hangs off to the left — and the animation translated left, away from them.
  Measured at 1920, three quarters through a cycle the last chip ended 1371px
  short of the right edge, and that much of the band was simply empty. The
  direction now follows the anchoring (see --marquee-dir in global.css), which
  is also the direction an RTL ticker belongs in: chips enter from the left.

  It duplicated the set exactly once, so even travelling the right way it only
  covered a viewport narrower than one set. Coverage is now measured rather
  than assumed: three copies ship in the markup so a no-JS render still fills a
  wide screen, and the script clones up to ceil(viewportWidth / setWidth) + 1 —
  the +1 being the copy that is mid-exit while the rest already fill the frame.

  And it travelled a percentage, which stops meaning "one set" the moment the
  copy count changes. The animation now moves exactly one set width: the script
  measures it and sets --set-width in pixels. The CSS default is 33.3333%,
  which is one set of the three that ship statically, so the loop stays
  seamless if the script never runs.

  Speed is fixed rather than duration: 40 px/s means a chip reads at the same
  pace whether the strip holds four items or twelve.

  Only the first set is exposed to assistive tech; every clone is aria-hidden,
  including the ones the script adds.
*/
interface Props {
  items: string[];
  label: string;
}

const { items, label } = Astro.props;

/*
  Three, not two. Two only covers a viewport narrower than one set, which is
  exactly the assumption that failed. Three covers roughly twice the widest set
  at load, and the script tops it up from there.
*/
const STATIC_SETS = 3;
const track = Array.from({ length: STATIC_SETS }, () => items).flat();
---

<section class="band bg-surface-blue" aria-label={label}>
  <div class="marquee" data-marquee>
    <ul class="marquee__track" data-marquee-track data-items-per-set={items.length} data-sets={STATIC_SETS}>
      {
        track.map((item, index) => {
          const isClone = index >= items.length;
          return (
            <li
              class="marquee__item mx-4 flex max-h-[70px] shrink-0 items-center gap-2 rounded-full border border-brand-200 bg-white hover:border-brand-400 px-5 py-3 md:mx-6"
              dir="rtl"
              data-clone={isClone ? '' : undefined}
              aria-hidden={isClone ? 'true' : undefined}
            >
              <span
                class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-700"
                aria-hidden="true"
              >
                <svg width="14" height="14" viewBox="0 0 20 20" fill="none">
                  <path
                    d="M10 15V7m0 0c0-2.2 1.8-3.7 4.4-3.7 0 2.6-1.8 4-4.4 3.7Zm0 1.5c0-1.8-1.5-3-3.7-3 0 2.2 1.5 3 3.7 3Z"
                    stroke="#fff"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
              <span class="whitespace-nowrap text-sm font-bold text-ink-900">{item}</span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  /*
    Orion hard-codes the loop distance and derives the duration from it. We do
    the reverse twice over: measure one set, clone until the strip covers the
    viewport, then derive the duration from a fixed speed — so the pace reads
    identically at 360px and at 1920px, with any number of items.
  */
  const PIXELS_PER_SECOND = 40;

  function calibrate(marquee: HTMLElement) {
    const track = marquee.querySelector<HTMLElement>('[data-marquee-track]');
    if (!track) return;

    const itemsPerSet = Number(track.dataset.itemsPerSet);
    if (!itemsPerSet) return;

    const items = Array.from(track.children) as HTMLElement[];
    const sets = Number(track.dataset.sets) || 1;

    /*
      Measured from the live layout rather than from scrollWidth / sets: the two
      agree today, but scrollWidth would quietly lie the moment an item wrapped
      or a margin collapsed, and this is the number the whole loop rests on.
    */
    const boundary = items[itemsPerSet];
    const setWidth = boundary ? boundary.offsetLeft - items[0].offsetLeft : track.scrollWidth / sets;
    if (setWidth <= 0) return;

    // +1: while one copy is exiting, the rest must already fill the frame.
    const needed = Math.ceil(marquee.clientWidth / setWidth) + 1;
    if (needed > sets) {
      const fragment = document.createDocumentFragment();
      for (let copy = sets; copy < needed; copy++) {
        for (let i = 0; i < itemsPerSet; i++) {
          const clone = items[i].cloneNode(true) as HTMLElement;
          clone.setAttribute('aria-hidden', 'true');
          clone.dataset.clone = '';
          fragment.appendChild(clone);
        }
      }
      track.appendChild(fragment);
      track.dataset.sets = String(needed);
    }

    marquee.style.setProperty('--set-width', `${setWidth}px`);
    marquee.style.setProperty('--marquee-duration', `${setWidth / PIXELS_PER_SECOND}s`);
  }

  for (const marquee of document.querySelectorAll<HTMLElement>('[data-marquee]')) {
    calibrate(marquee);

    // Fonts land after first paint and change the set width, so remeasure.
    document.fonts?.ready.then(() => calibrate(marquee));

    let frame = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => calibrate(marquee));
    });
  }
</script>
