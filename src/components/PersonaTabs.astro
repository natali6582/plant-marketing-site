---
/*
  Persona tabs — the three roles, on the home page.

  Progressive enhancement: the panels render open and the tab strip renders
  hidden, so a visitor without JavaScript reads all three roles stacked. The
  script reveals the strip and collapses the panels only once it can drive
  them, which is also why the per-panel heading is only hidden under `.js`.

  The sliding indicator and the 200ms panel crossfade are ours — Orion toggles
  `display` with no transition and marks the active tab with a static border
  (see motion-plan.md). The ARIA is ours too; their markup carries none.
*/
import { roles } from '../data/roles';
---

<section class="band bg-ink-50" aria-labelledby="personas-title">
  <div class="mx-auto max-w-5xl px-4">
    <!-- Heading and standfirst are the existing /solutions/ copy, reused verbatim. -->
    <h2 id="personas-title" class="text-center text-3xl text-ink-900">
      <span class="font-normal">פתרונות</span> <span class="font-black">לפי תפקיד</span>
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-ink-700">
      אותה פלטפורמה, שלושה תהליכי עבודה שונים. בחרו את התפקיד שלכם.
    </p>

    <div class="mt-8 tabs" data-tabs>
      <div class="relative" data-tabs-strip hidden>
        <div
          role="tablist"
          aria-labelledby="personas-title"
          class="flex justify-center gap-2 overflow-x-auto [scroll-snap-type:x_mandatory] md:gap-6"
        >
          {
            roles.map((role, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-${role.id}`}
                aria-controls={`panel-${role.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                class="shrink-0 [scroll-snap-align:center] border-b border-ink-300 px-4 py-3 text-sm font-semibold text-ink-700 transition-colors duration-[250ms] ease-in-out hover:text-brand-700 aria-selected:font-bold aria-selected:text-brand-700 md:text-lg"
                data-tab
              >
                {role.title}
              </button>
            ))
          }
        </div>
        <span
          class="tabs__indicator absolute bottom-0 left-0 block h-0.5 w-0 bg-brand-600"
          aria-hidden="true"
          data-tabs-indicator
        ></span>
      </div>

      <div class="mt-8">
        {
          roles.map((role, index) => (
            <div
              role="tabpanel"
              id={`panel-${role.id}`}
              aria-labelledby={`tab-${role.id}`}
              tabindex="0"
              class="tabs__panel focus-visible:outline-none"
              data-panel
              data-initial={index === 0 ? '' : undefined}
            >
              <h3 class="tabs__panel-title text-2xl font-black text-ink-900">{role.title}</h3>
              <p class="mt-3 max-w-2xl leading-relaxed text-ink-700">{role.intro}</p>
              <ul class="mt-6 grid gap-4 md:grid-cols-3">
                {role.points.map((point) => (
                  <li class="card-lift rounded-2xl border border-brand-100 bg-white p-5 text-sm leading-relaxed text-ink-700 shadow-sm">
                    {point}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const strip = root.querySelector<HTMLElement>('[data-tabs-strip]');
    const indicator = root.querySelector<HTMLElement>('[data-tabs-indicator]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    if (!strip || !indicator || tabs.length === 0) continue;

    // The strip is inert markup until the script that drives it is running.
    strip.hidden = false;

    function moveIndicator(tab: HTMLElement) {
      indicator!.style.width = `${tab.offsetWidth}px`;
      indicator!.style.transform = `translateX(${tab.offsetLeft}px)`;
    }

    function select(index: number, moveFocus: boolean) {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
      });
      moveIndicator(tabs[index]);
      if (moveFocus) tabs[index].focus();
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index, false));

      tab.addEventListener('keydown', (event) => {
        // The layout is RTL, so the visually-next tab is to the left.
        const step =
          event.key === 'ArrowLeft' ? 1 : event.key === 'ArrowRight' ? -1 : 0;

        if (step !== 0) {
          event.preventDefault();
          select((index + step + tabs.length) % tabs.length, true);
        } else if (event.key === 'Home') {
          event.preventDefault();
          select(0, true);
        } else if (event.key === 'End') {
          event.preventDefault();
          select(tabs.length - 1, true);
        }
      });
    });

    const initial = panels.findIndex((panel) => panel.dataset.initial !== undefined);
    select(initial === -1 ? 0 : initial, false);

    // The indicator is measured in pixels, so it has to be re-measured whenever
    // the strip reflows.
    const active = () => tabs[tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true')];
    document.fonts?.ready.then(() => moveIndicator(active()));

    let frame = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => moveIndicator(active()));
    });
  }
</script>
