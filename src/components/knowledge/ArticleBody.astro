---
import { getCollection } from 'astro:content';
import KeyFigures from './KeyFigures.astro';
import Layers from './Layers.astro';
import Compare from './Compare.astro';
import Timeline from './Timeline.astro';
import InvestmentExplorer from './InvestmentExplorer.astro';
import { inlineFigures, renderAlerts, splitBlocks } from './render';
import type { FigureData } from './figures';
import { CONCEPT_LAYERS, PLANNING_LAYERS } from '../../data/knowledge';
import { COMPARE, TIMELINE } from '../../data/knowledge-tables';

/*
  Renders an article body: prose chunks as HTML, block tokens as real
  components. See render.ts for why the articles carry tokens instead of MDX.
*/

interface Props {
  html: string;
  /* Named in error messages, so a bad id points at the file that has it. */
  slug: string;
}

const { html, slug } = Astro.props;

const figureEntries = await getCollection('figures');
const figures = new Map<string, FigureData>(figureEntries.map((e) => [e.id, e.data as FigureData]));

// Markdown tables get their own keyboard-scrollable region on narrow screens.
// Component tables already provide their own accessible overflow container.
const tableHtml = html.replace(/<table(?:\s[^>]*)?>[\s\S]*?<\/table>/g,
  table => `<div class="kb-table-wrap" tabindex="0" role="region" aria-label="טבלת השוואה — ניתן לגלול לרוחב">${table}</div>`);
const parts = splitBlocks(renderAlerts(inlineFigures(tableHtml, figures, slug)));

const LAYER_SETS: Record<string, typeof CONCEPT_LAYERS> = {
  concept: CONCEPT_LAYERS,
  planning: PLANNING_LAYERS,
};

/* A token naming something that does not exist fails the build rather than
   rendering nothing — the same rule the figures follow. */
for (const part of parts) {
  if (part.kind !== 'block') continue;
  const { name, arg } = part;
  if (name === 'layers' && !LAYER_SETS[arg]) throw new Error(`${slug}: {{layers:${arg}}} — unknown set.`);
  if (name === 'compare' && !COMPARE[arg]) throw new Error(`${slug}: {{compare:${arg}}} — not in knowledge-tables.ts.`);
  if (name === 'timeline' && !TIMELINE[arg]) throw new Error(`${slug}: {{timeline:${arg}}} — not in knowledge-tables.ts.`);
  if (name === 'explorer' && !['bond', 'structured'].includes(arg)) throw new Error(`${slug}: unknown explorer ${arg}`);
}
---

<div class="kb-prose">
  {
    parts.map((part) => {
      if (part.kind === 'html') return <Fragment set:html={part.html} />;
      if (part.name === 'keyfigures') return <KeyFigures ids={part.arg.split(',').map((s) => s.trim())} />;
      if (part.name === 'layers') return <Layers items={LAYER_SETS[part.arg]} />;
      if (part.name === 'timeline') return <Timeline items={TIMELINE[part.arg].items} />;
      if (part.name === 'explorer') return <InvestmentExplorer kind={part.arg as 'bond' | 'structured'} />;
      return <Compare {...COMPARE[part.arg]} />;
    })
  }
</div>

<style>
  :global(.kb-prose > .kb-table-wrap) { max-width: 100%; overflow-x: auto; }
  :global(.kb-table-wrap > table) { width: 100%; border-collapse: collapse; font-size: .95rem; line-height: 1.7; }
  :global(.kb-table-wrap th), :global(.kb-table-wrap td) { min-width: 120px; padding: .75rem; border: 1px solid var(--color-brand-200); text-align: start; vertical-align: top; }
  :global(.kb-table-wrap th) { background: var(--color-surface-blue); color: var(--color-brand-800); }
  :global(.kb-prose details) { padding: 1rem; border: 1px solid var(--color-brand-200); border-radius: .75rem; }
  :global(.kb-prose summary) { cursor: pointer; color: var(--color-brand-800); font-weight: 700; }
  :global(.kb-prose details[open] > :not(summary)) { margin-top: .75rem; }
  :global(.kb-prose code) { direction: ltr; unicode-bidi: isolate; overflow-wrap: anywhere; }
  @media print { :global(.kb-table-wrap > table) { font-size: .8rem; } :global(.kb-table-wrap th), :global(.kb-table-wrap td) { min-width: 0; } }
</style>
