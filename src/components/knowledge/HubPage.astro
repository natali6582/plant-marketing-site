---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import DuotoneIcon from '../DuotoneIcon.astro';
import LayersDiagram from './LayersDiagram.astro';
import RegulatorsDiagram from './RegulatorsDiagram.astro';
import Disclaimer from './Disclaimer.astro';
import { BIG_IDEAS, KNOWLEDGE_DRAFTS, TRACKS } from '../../data/knowledge';
import { figuresPath } from './figures';
import { getCollection } from 'astro:content';

/*
  /knowledge/ — the hub. Rendered from the section's one route rather than from
  a page of its own: a static index.astro still writes an index.html even when
  its body bails out, which leaked an empty /knowledge/ into production builds
  with the flag off. As a component it simply is not called.

  Professional approval is tracked in docs/knowledge-tools/status.md.
  KNOWLEDGE_ENABLED controls availability; KNOWLEDGE_DRAFTS preserves noindex
  until Natali's line-by-line review and an explicit indexing decision.

  Meeting resources are directly reachable below the hero. The conceptual
  sections retain their order after this navigation block.

  The diagrams use live SVG text plus screen-reader summaries, not the
  AI-generated images that came with the brief and spell Hebrew incorrectly.
*/

const figures = await getCollection('figures');
const latestYear = Math.max(...figures.map((f) => f.data.year));

const articles = await getCollection('knowledge');
const visibleArticles = articles.filter((article) => !article.data.draft || KNOWLEDGE_DRAFTS);
const inTrack = (slug: string, article: (typeof articles)[number]) => {
  const audience = article.data.audience;
  return Array.isArray(audience) ? audience.includes(slug as never) : audience === slug;
};
const perTrack = (slug: string) =>
  visibleArticles.filter((article) => inTrack(slug, article) || inTrack('shared', article)).length;
---

<BaseLayout
  title="מרכז ידע | Plan-T"
  description="תוכן מקצועי וחינוכי על הנכסים, המוצרים והמעטפות בשוק הישראלי: מה מייצר את החשיפה, באיזו מעטפת היא מוחזקת, ומי מפקח על מה."
  noindex={KNOWLEDGE_DRAFTS}
>
  <PageHero size="compact" seed={4} eyebrow="מרכז ידע">
    <Fragment slot="title">הנכסים, המוצרים והמעטפות — מפה אחת</Fragment>
    <Fragment slot="lead">
      אותה חשיפה כלכלית יכולה לשבת בחמש מעטפות שונות, ולהתנהג בכל אחת מהן אחרת לגמרי. מרכז הידע
      מסביר את ההבחנה הזו, ומה היא משנה בפועל.
    </Fragment>
  </PageHero>

  <section class="meeting-tools" aria-labelledby="meeting-tools-title">
    <div class="meeting-tools-inner">
      <div class="meeting-tools-header">
        <div>
          <h2 id="meeting-tools-title">כלים וערכות לפגישה</h2>
          <p>מחשבונים, ערכות ומדריכים לשימוש בפגישת לקוח.</p>
        </div>
        <a class="meeting-tools-directory" href="/knowledge/tools/">למדריך הכלים המקצועיים</a>
      </div>
      <ul>
        {TRACKS.map((track) => (
          <li>
            <a class="meeting-tools-track" href={`/knowledge/${track.slug}/#meeting-tools`}>
              <DuotoneIcon name={track.icon} />
              <span class="meeting-tools-name">{track.name}</span>
              <span class="meeting-tools-label">לכלים ולערכות במסלול</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- The three framings, which are the section's thesis. -->
  <section class="band bg-white" aria-labelledby="ideas-title">
    <div class="mx-auto max-w-5xl px-4">
      <h2 id="ideas-title" class="reveal-lines text-center text-3xl font-bold text-brand-800">
        שלושה רעיונות להכיר
      </h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          BIG_IDEAS.map((idea) => (
            <li class="reveal card-lift rounded-2xl border border-brand-200 bg-white p-6 shadow-sm hover:border-brand-400">
              <DuotoneIcon name={idea.icon} />
              <h3 class="mt-3 text-lg font-bold text-brand-800">{idea.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-700">{idea.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band bg-surface-blue" aria-labelledby="map-title">
    <div class="mx-auto max-w-3xl px-4">
      <h2 id="map-title" class="reveal-lines text-3xl font-bold text-brand-800">מפת המושגים המשותפת</h2>
      <p class="reveal mt-4 leading-relaxed text-ink-700">
        הסיווג מתחיל בשתי שאלות: מהי החשיפה הכלכלית, ובאיזו מעטפת היא מוחזקת. ארבע השכבות האלה הן
        אותן שתי שאלות, מפורקות.
      </p>
      <div class="reveal mt-8">
        <LayersDiagram />
      </div>
    </div>
  </section>

  <section class="band bg-white" aria-labelledby="regulators-title">
    <div class="mx-auto max-w-5xl px-4">
      <h2 id="regulators-title" class="reveal-lines text-3xl font-bold text-brand-800">מי מפקח על מה</h2>
      <p class="reveal mt-4 max-w-3xl leading-relaxed text-ink-700">
        הפיקוח מחולק לפי סוג המעטפת, לא לפי סוג הלקוח. אותו חוסך יכול להחזיק באותה שנה נכסים
        בארבעה תחומי פיקוח שונים.
      </p>
      <div class="reveal mt-8">
        <RegulatorsDiagram />
      </div>
    </div>
  </section>

  <section class="band bg-surface-blue" aria-labelledby="tracks-title">
    <div class="mx-auto max-w-5xl px-4">
      <h2 id="tracks-title" class="reveal-lines text-center text-3xl font-bold text-brand-800">שלושה מסלולים</h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {
          TRACKS.map((track) => (
            <li class="reveal card-lift rounded-2xl border border-brand-200 bg-white p-6 shadow-sm hover:border-brand-400">
              <DuotoneIcon name={track.icon} />
              <h3 class="mt-3 text-lg font-bold text-brand-800">
                <a href={`/knowledge/${track.slug}/`} class="hover:underline">{track.name}</a>
              </h3>
              <p class="mt-2 leading-relaxed text-ink-700">{track.lead}</p>
              <p class="mt-3 text-sm text-ink-700">
                <span class="ltr">{perTrack(track.slug)}</span>&#32;מאמרים
              </p>
            </li>
          ))
        }
      </ul>

      <p class="reveal mt-10 text-center">
        <a href={figuresPath(latestYear)} class="font-bold text-brand-600 underline hover:text-brand-800">
          {KNOWLEDGE_DRAFTS ? 'כל התקרות והסכומים' : 'התקרות והסכומים המאומתים'} לשנת{' '}
          <span class="ltr">{latestYear}</span>, בדף אחד
        </a>
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 pb-16">
    <Disclaimer />
  </div>
</BaseLayout>

<style>
  .meeting-tools { padding: 40px 16px; background: var(--color-surface-blue); }
  .meeting-tools-inner { max-width: 1024px; margin-inline: auto; }
  .meeting-tools-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .meeting-tools h2 { font-size: 1.875rem; font-weight: 700; color: var(--color-brand-800); }
  .meeting-tools p { margin-top: 8px; line-height: 1.7; color: var(--color-ink-700); }
  .meeting-tools-directory { padding: 12px 18px; border: 1px solid var(--color-brand-600); border-radius: 12px; color: var(--color-brand-600); font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .meeting-tools ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 24px; padding: 0; list-style: none; }
  .meeting-tools-track { display: flex; height: 100%; flex-direction: column; align-items: flex-start; gap: 8px; padding: 20px; border: 1px solid var(--color-brand-200); border-radius: 16px; background: white; }
  .meeting-tools-name { color: var(--color-brand-800); font-size: 1.125rem; font-weight: 700; }
  .meeting-tools-label { color: var(--color-brand-600); text-decoration: underline; text-underline-offset: 4px; }
  .meeting-tools a:hover { border-color: var(--color-brand-600); background: var(--color-brand-50); }
  .meeting-tools a:focus-visible { outline: 3px solid var(--color-brand-600); outline-offset: 4px; }
  @media (max-width: 640px) { .meeting-tools ul { grid-template-columns: 1fr; } }
</style>
