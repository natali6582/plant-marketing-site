---
import { bondScenario, maturityNote } from '../../lib/knowledge-explorers';
interface Props { kind: 'bond' | 'structured' }
const { kind } = Astro.props;
const isBond = kind === 'bond';
const base = bondScenario(4, 4, 5);
const rows = isBond
  ? [{ label: '3% — ירידה בנקודת אחוז', value: base.lower }, { label: '4% — הנחת הבסיס', value: base.base }, { label: '5% — עלייה בנקודת אחוז', value: base.higher }]
  : [40, 59.99, 60, 80, 100, 110, 120, 160].map(level => ({label: String(level), value: maturityNote(level).repayment}));
const fmt = (n: number) => n.toLocaleString('he-IL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---
<section class="investment-explorer not-prose" data-investment-explorer={kind} aria-labelledby={`${kind}-explorer-title`}>
  <h2 id={`${kind}-explorer-title`}>{isBond ? 'מה קורה למחיר כשהתשואה משתנה?' : 'מה מתקבל במועד הפירעון?'}</h2>
  <p class="explorer-context">{isBond
    ? 'דוגמה לימודית: ערך נקוב 100, קופון שנתי קבוע, תשלום בסוף כל שנה ופירעון מלא בסוף התקופה. ההיוון נעשה ביום תשלום קופון, ללא ריבית צבורה, מס, עמלות, הצמדה, פדיון מוקדם או חדלות פירעון.'
    : 'מוצר בדיוני בלבד: השקעה ומדד התחלתי 100, חסם 60 שנבדק בפירעון בלבד, השתתפות מלאה בעלייה עד רווח של 20%, ללא קופון או פדיון אוטומטי. המנפיק עומד בתשלומים. אין כאן מחיר מכירה לפני הפירעון.'}</p>
  <form class="explorer-inputs" novalidate>
    {isBond ? <>
      <label for="bond-coupon">קופון שנתי (%)<input id="bond-coupon" name="coupon" type="number" min="0" max="15" step="0.1" value="4" required /></label>
      <label for="bond-yield">תשואה שנתית להיוון (%)<input id="bond-yield" name="yield" type="number" min="-2" max="20" step="0.1" value="4" required /></label>
      <label for="bond-years">שנים לפירעון<input id="bond-years" name="years" type="number" min="1" max="30" step="1" value="5" required /></label>
    </> : <label for="structured-level">רמת המדד בפירעון (התחלה: 100)<input id="structured-level" name="level" type="number" min="0" max="200" step="0.01" value="80" required /></label>}
    <div class="explorer-actions"><button type="submit" disabled>עדכון הדוגמה</button><button type="reset" disabled>איפוס</button></div>
  </form>
  <p class="explorer-error" data-explorer-error role="alert" hidden></p>
  <div data-explorer-results>
    {!isBond && <svg class="payoff-chart" viewBox="0 0 360 220" role="img" aria-labelledby="payoff-title payoff-description">
      <title id="payoff-title">מדד בפירעון מול סכום הפירעון</title>
      <desc id="payoff-description">עד החסם הפירעון יורד עם המדד. בחסם 60 יש קפיצה להחזר 100; מעל מדד 100 יש השתתפות עד פירעון מרבי 120. הטבלה מפרטת את הערכים.</desc>
      <path d="M40 20V180H340" fill="none" stroke="currentColor" />
      <path d="M40 180L130 102 M130 50H190L220 24H340" fill="none" stroke="var(--color-brand-700)" stroke-width="3" />
      <path d="M130 180V24" stroke="var(--color-ink-400)" stroke-dasharray="4 4" />
      <circle cx="130" cy="102" r="4" fill="white" stroke="var(--color-brand-700)" stroke-width="2" />
      <circle cx="130" cy="50" r="4" fill="var(--color-brand-700)" />
      <circle data-payoff-point cx="160" cy="50" r="6" fill="var(--color-brand-800)" stroke="white" stroke-width="2" />
      <g font-size="12" fill="currentColor" text-anchor="middle"><text x="40" y="198">0</text><text x="130" y="198">60</text><text x="190" y="198">100</text><text x="340" y="198">200</text><text x="190" y="217">מדד בפירעון</text><text x="22" y="180">0</text><text x="22" y="53">100</text><text x="22" y="27">120</text></g>
    </svg>}
    <p class="explorer-answer" aria-live="polite" aria-atomic="true" data-explorer-answer>
      {isBond ? 'המחיר בהנחת הבסיס: 100.00 לכל 100 ערך נקוב.' : 'סכום הפירעון: 100.00 לכל 100 שהושקעו. רווח או הפסד: 0.00.'}
    </p>
    <p data-explorer-explanation>{isBond ? 'הקופון שווה לתשואה ולכן המחיר בדוגמה שווה לערך הנקוב. בכל תרחיש מחשבים מחדש את כל תזרימי המזומנים.' : 'רמת המדד מעל החסם ומתחת לרמה ההתחלתית: הקרן מוחזרת לפי תנאי הדוגמה, בכפוף ליכולת התשלום של המנפיק.'}</p>
    <div class="explorer-table-wrap" tabindex="0" role="region" aria-label="טבלת תרחישים לדוגמה">
      <table>
        <caption>{isBond ? 'רגישות לשינוי של נקודת אחוז אחת בתשואה' : 'תרחישים קבועים לאותו מוצר בדיוני — שימו לב לקפיצה בחסם'}</caption>
        <thead><tr><th scope="col">{isBond ? 'תשואה להיוון' : 'מדד בפירעון'}</th><th scope="col">{isBond ? 'מחיר לכל 100 ערך נקוב' : 'סכום פירעון לכל 100'}</th></tr></thead>
        <tbody data-explorer-rows>{rows.map(row => <tr><td>{row.label}</td><td dir="ltr">{fmt(row.value)}</td></tr>)}</tbody>
      </table>
    </div>
  </div>
  <noscript><p>הדוגמה וטבלת התרחישים זמינות לקריאה. לשינוי הקלט יש להפעיל JavaScript בדפדפן.</p></noscript>
</section>
<script>
  import { bondScenario, maturityNote } from '../../lib/knowledge-explorers';
  const format = (n: number) => n.toLocaleString('he-IL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  document.querySelectorAll<HTMLElement>('[data-investment-explorer]').forEach(root => {
    const form = root.querySelector('form')!;
    const results = root.querySelector<HTMLElement>('[data-explorer-results]')!;
    const error = root.querySelector<HTMLElement>('[data-explorer-error]')!;
    const answer = root.querySelector<HTMLElement>('[data-explorer-answer]')!;
    const explanation = root.querySelector<HTMLElement>('[data-explorer-explanation]')!;
    const body = root.querySelector('tbody')!;
    const isBond = root.dataset.investmentExplorer === 'bond';
    const update = () => {
      const inputs = [...form.querySelectorAll('input')];
      if (inputs.some(input => !input.validity.valid || input.value.trim() === '' || !Number.isFinite(input.valueAsNumber))) {
        error.textContent = isBond ? 'יש להזין קופון בין 0 ל־15 ותשואה בין ‎−2 ל־20, בקפיצות של 0.1, ושנים שלמות בין 1 ל־30.' : 'יש להזין רמת מדד בין 0 ל־200, עד שתי ספרות אחרי הנקודה. אפס הוא ערך תקין.';
        error.hidden = false; results.hidden = true; return;
      }
      error.hidden = true; results.hidden = false;
      if (isBond) {
        const [coupon, yieldRate, years] = inputs.map(input => input.valueAsNumber);
        const r = bondScenario(coupon, yieldRate, years);
        answer.textContent = `המחיר בהנחת הבסיס: ${format(r.base)} לכל 100 ערך נקוב.`;
        explanation.textContent = 'הטבלה מחשבת מחדש את כל הקופונים ואת הקרן בכל תשואה. היא אינה משתמשת בקירוב מח״מ, ואינה מתארת שינוי בסיכון האשראי.';
        const scenarios = [[yieldRate - 1, r.lower], [yieldRate, r.base], [yieldRate + 1, r.higher]];
        body.replaceChildren(...scenarios.map(([rate, value]) => {
          const row = document.createElement('tr');
          const a = document.createElement('td'); const b = document.createElement('td');
          a.textContent = `${format(rate)}%`; a.dir = 'ltr'; b.textContent = format(value); b.dir = 'ltr';
          row.append(a,b); return row;
        }));
      } else {
        const r = maturityNote(inputs[0].valueAsNumber);
        const point = root.querySelector('[data-payoff-point]')!;
        point.setAttribute('cx', String(40 + inputs[0].valueAsNumber * 1.5));
        point.setAttribute('cy', String(180 - r.repayment * 1.3));
        answer.textContent = `סכום הפירעון: ${format(r.repayment)} לכל 100 שהושקעו. רווח או הפסד: ${format(r.profit)}.`;
        explanation.textContent = {
          loss: 'המדד מתחת לחסם: ההפסד נמדד מהרמה ההתחלתית, ולא רק מהמרחק מתחת לחסם. אפשר לאבד את מלוא ההשקעה.',
          protected: 'המדד בחסם או מעליו, ועד הרמה ההתחלתית: הקרן מוחזרת לפי תנאי הדוגמה, בכפוף ליכולת התשלום של המנפיק.',
          participation: 'המדד עלה: הפירעון כולל את העלייה, כל עוד לא הגיעה לתקרת הרווח בדוגמה.',
          capped: 'הרווח הגיע לתקרה בדוגמה. עלייה נוספת במדד אינה מגדילה את הפירעון.',
        }[r.branch];
      }
    };
    form.querySelectorAll('button').forEach(button => button.disabled = false);
    form.addEventListener('submit', event => { event.preventDefault(); update(); });
    form.addEventListener('input', update);
    // A microtask can run before the native reset default action on a user click.
    // Recalculate in the next task, after the browser has restored the inputs.
    form.addEventListener('reset', () => setTimeout(update, 0));
  });
</script>
<style>
  .investment-explorer { margin-block: 2rem; padding: 1.5rem; border: 1px solid var(--color-brand-200); border-radius: 1rem; background: var(--color-surface-blue); }
  .investment-explorer h2 { margin-top: 0; font-size: 1.4rem; }
  .explorer-context, .explorer-answer, [data-explorer-explanation] { margin-block: 1rem; }
  .explorer-inputs { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; }
  .explorer-inputs label { display: flex; flex-direction: column; gap: .5rem; font-weight: 700; color: var(--color-ink-700); }
  .explorer-inputs input { width: 100%; min-width: 0; background: white; border: 1px solid var(--color-brand-600); padding: .65rem; border-radius: .5rem; direction: ltr; }
  .explorer-actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: .75rem; }
  .explorer-actions button { border: 1px solid var(--color-brand-700); padding: .65rem 1rem; border-radius: .5rem; cursor: pointer; font-weight: 700; color: var(--color-brand-800); background: white; }
  .explorer-actions button:first-child { background: var(--color-brand-800); color: white; }
  .explorer-actions button:disabled { opacity: .55; cursor: default; }
  .explorer-error { color: var(--color-warn-700); font-weight: 700; }
  .explorer-answer { font-weight: 700; color: var(--color-brand-800); }
  .explorer-table-wrap { overflow-x: auto; }
  .payoff-chart { display: block; width: 100%; max-width: 480px; height: auto; margin: 1.5rem auto; background: white; padding: .5rem; direction: ltr; color: var(--color-ink-700); }
  table { width: 100%; border-collapse: collapse; background: white; }
  th, td { padding: .65rem; text-align: start; border: 1px solid var(--color-brand-200); }
  th { color: var(--color-brand-800); }
  caption { text-align: start; margin-block: .5rem; }
  @media (max-width: 480px) { .investment-explorer { padding: 1rem; } .explorer-inputs { grid-template-columns: 1fr; } }
</style>
