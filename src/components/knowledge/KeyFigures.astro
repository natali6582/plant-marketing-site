---
import { getEntry } from 'astro:content';
import { formatFigure, figuresPath, wrapAtomicRuns } from './figures';

/*
  Two to four numbers as a strip of cards, for the top of an article where the
  reader wants the ceilings before the prose.

  Same source of truth as <Figure>, same rule: ids, never typed values. The
  year sits under each number rather than in a footnote, because a reader who
  screenshots one card should still be holding a dated figure.
*/

interface Props {
  ids: string[];
}

const { ids } = Astro.props;

const figures = await Promise.all(
  ids.map(async (id) => {
    const entry = await getEntry('figures', id);
    if (!entry) throw new Error(`<KeyFigures/> references "${id}", which is not in src/data/figures.yaml.`);
    return { id, ...entry.data };
  })
);
---

<ul class="not-prose my-8 grid gap-4 sm:grid-cols-2" data-key-figures>
  {
    figures.map((f) => (
      <li class="rounded-2xl border border-brand-200 bg-white p-5 shadow-sm">
        <p class="text-2xl font-bold text-brand-800">
          <span class="ltr">{formatFigure(f)}</span>
        </p>
        <p class="mt-1 text-sm leading-relaxed text-ink-700">{f.label}</p>
        <p class="mt-3 text-xs text-ink-700">
          נכון ל-<span class="ltr">{f.year}</span> ·&#32;
          <a href={`${figuresPath(f.year)}#${f.id}`} class="underline hover:text-brand-700">{f.source.label}</a>
        </p>
        {f.note && <p class="mt-2 text-xs leading-relaxed text-ink-700" set:html={wrapAtomicRuns(f.note)} />}
      </li>
    ))
  }
</ul>
