---
import DuotoneIcon from '../DuotoneIcon.astro';

/*
  The stack diagram — four layers on the hub, six on the "how it fits" pages.

  This is HTML with live text rather than a picture, and that is a rule rather
  than a preference (§5.5): a diagram of the Israeli product map has to be
  searchable, translatable, selectable and legible to a screen reader, and an
  exported PNG is none of those. It is an ordered list, so the order is carried
  by the markup and not only by the visual.

  The number uses .rtl-marker rather than .ltr — see the note on that rule in
  global.css for why the obvious choice puts the gap on the wrong side.

  Each layer may carry an icon, a question, and examples. The question column
  is what the doc's own table leads with — "מה יוצר רווח או הפסד?" — and it is
  the part that makes the stack teach rather than label.
*/

export interface Layer {
  title: string;
  body: string;
  examples?: string[];
  question?: string;
  icon?: string;
}

interface Props {
  items: Layer[];
  /* Both stacks are numbered, because both are numbered in the source and the
     articles cite the numbers — "שכבה 2 ואת שכבה 4" is unreadable beside an
     unnumbered list. The flag stays for a stack that is genuinely a set rather
     than a sequence. */
  numbered?: boolean;
}

const { items, numbered = true } = Astro.props;
---

<ol class="not-prose my-8 space-y-3" data-layers>
  {
    items.map((layer, index) => (
      <li class="rounded-2xl border border-brand-200 bg-white p-5 shadow-sm md:p-6">
        <div class="flex items-start gap-4">
          {layer.icon && (
            <div class="shrink-0">
              <DuotoneIcon name={layer.icon} size="md" />
            </div>
          )}
          <div class="min-w-0">
            <h3 class="text-lg font-bold text-brand-800">
              {numbered && <span class="rtl-marker text-brand-500">{index + 1}.</span>}
              {layer.title}
            </h3>
            <p class="mt-2 leading-relaxed text-ink-700">{layer.body}</p>
            {layer.examples && layer.examples.length > 0 && (
              <p class="mt-3 text-sm text-ink-700">
                <span class="font-bold">דוגמאות:</span>&#32;{layer.examples.join(' · ')}
              </p>
            )}
            {layer.question && (
              <p class="mt-3 border-s-2 border-brand-300 ps-3 text-sm font-bold text-brand-700">
                {layer.question}
              </p>
            )}
          </div>
        </div>
      </li>
    ))
  }
</ol>
