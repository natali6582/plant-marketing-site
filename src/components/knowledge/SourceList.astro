---
import { TIER_LABEL } from './figures';

/*
  The sources block at the foot of an article.

  Tier is shown, not hidden, because the difference between "רשות ניירות ערך"
  and "אתר מקצועי שמסביר את רשות ניירות ערך" is the whole difference between a
  fact and a paraphrase. A tier-0 entry has no link yet and says so plainly —
  that is a visible gap in review rather than a plausible-looking link nobody
  ever checked.
*/

interface Props {
  sources: { label: string; url: string; tier: 0 | 1 | 2 }[];
}

const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="not-prose mt-10" aria-labelledby="sources-title">
      <h2 id="sources-title" class="text-lg font-bold text-brand-800">מקורות</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {sources.map((s) => (
          <li class="flex flex-wrap items-baseline gap-2">
            <span
              class:list={[
                'rounded-full px-2 py-0.5 text-xs font-bold',
                s.tier === 1 && 'bg-brand-100 text-brand-800',
                s.tier === 2 && 'bg-surface-blue text-ink-700',
                s.tier === 0 && 'bg-warn-100 text-ink-900',
              ]}
            >
              {TIER_LABEL[s.tier]}
            </span>
            {s.url ? (
              <a href={s.url} class="text-brand-600 underline hover:text-brand-800" rel="noopener">{s.label}</a>
            ) : (
              <span class="text-ink-700">{s.label}</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}
