---
const { track } = Astro.props;
const modules = import.meta.glob<{ resources: { track: string; title: string; description: string; href: string; type: string }[] }>('../../data/knowledge-resources/*.ts', { eager: true });
const resources = Object.values(modules).flatMap(m => m.resources).filter(r => r.track === track);
---
<section id="meeting-tools" class="knowledge-resources" aria-labelledby="resources-title" tabindex="-1">
  <div class="kr-inner"><h2 id="resources-title">כלים וערכות לפגישת לקוח</h2><ul>{resources.map(r => <li><p>{r.type}</p><h3><a href={r.href}>{r.title}</a></h3><p>{r.description}</p></li>)}</ul><p class="kr-directory"><a href={`/knowledge/tools/#${track}`}>למדריך הכלים החיצוניים והמקורות הרשמיים</a></p></div>
</section>
<style>
  .knowledge-resources { padding: 40px 24px; background: var(--color-surface-blue); scroll-margin-top: 6rem; }
  .kr-inner { max-width: 1024px; margin: auto; }
  h2 { font-size: 1.7rem; color: var(--color-brand-800); }
  ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; list-style: none; padding: 0; margin-block: 22px; }
  li { padding: 22px; background: white; border: 1px solid var(--color-brand-200); border-radius: 12px; }
  h3 { font-size: 1.15rem; font-weight: 700; margin-block: 8px; }
  p { line-height: 1.7; }
  a { color: var(--color-brand-600); text-decoration: underline; text-underline-offset: 3px; }
  .kr-directory { margin-top: 20px; }
</style>
