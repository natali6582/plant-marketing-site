---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** 'minimal' renders logo-only navigation for campaign pages; the default is the full chrome. */
  chrome?: 'full' | 'minimal';
}

const { title, description, ogImage = '/images/og.png', chrome = 'full' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Marks the document script-capable before the first paint, so the
      scroll-reveal styles apply only where the script that undoes them can
      run. Inline and synchronous on purpose: deferring it would flash the
      content in before hiding it.
    -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="he_IL" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Search-engine site verification, copied verbatim from the old site's
         <head> (plan-t.org.il, 02/09/2026) so the properties carry over at
         cutover and Search Console's change-of-address can be filed. Values,
         not secrets: they only prove ownership of a domain we already own. -->
    <meta name="google-site-verification" content="lJsQkE9-KmEIiDVCHA8JYTAyGRhCe2xnhxXcXozJksI" />
    <meta name="msvalidate.01" content="B0EFBB152549A0828828C4A65FA32488" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;900&family=Noto+Serif+Hebrew:wght@700&display=swap"
      rel="stylesheet"
    />
    <!-- Analytics: add the GA4 / Plausible snippet here once the choice from ambiguity #5 is made -->
  </head>
  <body class="min-h-screen bg-surface text-ink-900 antialiased">
    <a href="#main" class="skip-link">דילוג לתוכן הראשי</a>
    <Header minimal={chrome === 'minimal'} />
    <main id="main">
      <slot />
    </main>
    <Footer minimal={chrome === 'minimal'} />

    <script>
      // Fade-up on enter, staggered within a group; inert under reduced motion.
      const STAGGER_MS = 70;

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );

      // Siblings that reveal together are offset from each other, so a row of
      // cards arrives in sequence rather than all at once. The delay is per
      // parent, so an element that is alone in its group has none.
      const groups = new Map<Element, Element[]>();
      for (const el of document.querySelectorAll('.reveal')) {
        const parent = el.parentElement;
        if (!parent) continue;
        const siblings = groups.get(parent) ?? [];
        siblings.push(el);
        groups.set(parent, siblings);
      }

      /*
        A zero-height viewport — a hidden pane, a headless capture, an
        offscreen embed — gives IntersectionObserver nothing to intersect
        against, so it never fires. The CSS has already hidden these, so
        without this escape they would stay hidden for good.
      */
      const canReveal =
        'IntersectionObserver' in window && window.innerHeight > 0;

      for (const siblings of groups.values()) {
        siblings.forEach((el, index) => {
          if (!canReveal) {
            el.classList.add('is-visible');
            return;
          }
          if (siblings.length > 1) {
            (el as HTMLElement).style.setProperty(
              '--reveal-delay',
              `${index * STAGGER_MS}ms`
            );
          }
          observer.observe(el);
        });
      }

      /*
        Line reveal — headings hinge in one line at a time.

        Values measured from the Toptech theme; see motion-plan.md. It drives
        the effect with GSAP + ScrollTrigger and a paid line-splitter. Here the
        splitting is done by grouping words on their measured line box, which
        needs no library and works the same in RTL, and the animation itself is
        a plain CSS transition.

        The split runs when the heading enters view, not on load, so the line
        boxes always match the layout the visitor actually has — a resize
        before the reveal cannot leave the lines wrapped against a stale width.
      */
      const LINE_STAGGER_MS = 100;
      const stillMoves = window.matchMedia('(prefers-reduced-motion: no-preference)');

      /*
        The hidden state is armed by script, never by the stylesheet alone, and
        only once we know an observer can actually report on this viewport. A
        zero-height viewport — a hidden pane, a headless capture, an offscreen
        embed — gives IntersectionObserver nothing to intersect against, so it
        never fires and anything hidden by CSS would stay hidden for good.
        Unarmed means visible: the animation is the enhancement, not the
        content's precondition.
      */
      const canObserve =
        'IntersectionObserver' in window && window.innerHeight > 0;

      // Words become the atomic units; existing inline elements (.ltr spans and
      // the like) are kept whole so their own styling and bidi isolation survive.
      function toWordUnits(host: HTMLElement): HTMLElement[] {
        const units: HTMLElement[] = [];

        for (const child of [...host.childNodes]) {
          if (child.nodeType === Node.TEXT_NODE) {
            const parts = (child.textContent ?? '').split(/(\s+)/);
            const fragment = document.createDocumentFragment();

            for (const part of parts) {
              if (!part) continue;
              if (/^\s+$/.test(part)) {
                fragment.appendChild(document.createTextNode(part));
                continue;
              }
              const word = document.createElement('span');
              word.textContent = part;
              fragment.appendChild(word);
              units.push(word);
            }
            child.replaceWith(fragment);
          } else if (child.nodeType === Node.ELEMENT_NODE) {
            units.push(child as HTMLElement);
          }
        }

        return units;
      }

      function splitIntoLines(host: HTMLElement) {
        const units = toWordUnits(host);
        if (units.length === 0) return;

        // Group by the top of each unit's line box.
        const lines: HTMLElement[][] = [];
        let lastTop: number | null = null;

        for (const unit of units) {
          const top = Math.round(unit.getBoundingClientRect().top);
          if (lastTop === null || Math.abs(top - lastTop) > 2) {
            lines.push([]);
            lastTop = top;
          }
          lines[lines.length - 1].push(unit);
        }

        lines.forEach((line, index) => {
          const wrapper = document.createElement('span');
          wrapper.className = 'line';
          wrapper.style.setProperty('--line-delay', `${index * LINE_STAGGER_MS}ms`);

          /*
            Move the whole run from the first unit to the last, not just the
            units themselves: the spaces between words are separate text nodes,
            and leaving them outside the wrapper renders the line with its
            words jammed together.
          */
          const first = line[0];
          const last = line[line.length - 1];
          first.before(wrapper);

          let node: ChildNode | null = first;
          while (node) {
            const next: ChildNode | null = node === last ? null : node.nextSibling;
            wrapper.appendChild(node);
            node = next;
          }
        });
      }

      const lineObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const host = entry.target as HTMLElement;
            lineObserver.unobserve(host);

            splitIntoLines(host);
            host.classList.add('is-split');
            // Two frames: one for the split to land, one for the browser to
            // register the start state before the transition to it is undone.
            requestAnimationFrame(() =>
              requestAnimationFrame(() => host.classList.add('is-visible'))
            );
          }
        },
        // Matches the reference's ScrollTrigger `start: "top 90%"`.
        { rootMargin: '0px 0px -10% 0px' }
      );

      for (const el of document.querySelectorAll<HTMLElement>('.reveal-lines')) {
        // Reduced motion, or nothing to measure against: leave it unarmed, and
        // therefore plainly visible.
        if (!stillMoves.matches || !canObserve) continue;

        el.classList.add('is-armed');
        lineObserver.observe(el);
      }
    </script>
  </body>
</html>
