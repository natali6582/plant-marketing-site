---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/images/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Marks the document script-capable before the first paint, so the
      scroll-reveal styles apply only where the script that undoes them can
      run. Inline and synchronous on purpose: deferring it would flash the
      content in before hiding it.
    -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="he_IL" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <!-- Analytics: add the GA4 / Plausible snippet here once the choice from ambiguity #5 is made -->
  </head>
  <body class="min-h-screen bg-surface text-ink-900 antialiased">
    <a href="#main" class="skip-link">דילוג לתוכן הראשי</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Fade-up on enter, staggered within a group; inert under reduced motion.
      const STAGGER_MS = 70;

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );

      // Siblings that reveal together are offset from each other, so a row of
      // cards arrives in sequence rather than all at once. The delay is per
      // parent, so an element that is alone in its group has none.
      const groups = new Map<Element, Element[]>();
      for (const el of document.querySelectorAll('.reveal')) {
        const parent = el.parentElement;
        if (!parent) continue;
        const siblings = groups.get(parent) ?? [];
        siblings.push(el);
        groups.set(parent, siblings);
      }

      for (const siblings of groups.values()) {
        siblings.forEach((el, index) => {
          if (siblings.length > 1) {
            (el as HTMLElement).style.setProperty(
              '--reveal-delay',
              `${index * STAGGER_MS}ms`
            );
          }
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
