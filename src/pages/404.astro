---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="הדף לא נמצא | Plan-T" description="הדף שחיפשתם אינו קיים באתר Plan-T.">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="ltr text-6xl font-black text-ink-400">404</p>
    <h1 class="mt-4 text-3xl font-bold text-brand-800">הדף לא נמצא</h1>
    <p class="mt-4 text-ink-700">ייתכן שהקישור השתנה או שהוקלד בטעות.</p>
    <!-- PR F: the prompt asked for a branded Hebrew 404 with four ways out. The
         page was already branded; it had one link. Now: Home as the primary,
         and the three destinations a lost visitor most likely wanted. -->
    <a href="/" class="btn-pill btn-solid mt-8 inline-block rounded-full px-8 py-3 font-bold text-white">
      חזרה לדף הבית
    </a>
    <nav aria-label="דפים מרכזיים" class="mt-6 flex flex-wrap justify-center gap-3 text-sm">
      <a href="/product/" class="rounded-full border border-brand-200 px-4 py-2 font-medium text-brand-800 hover:bg-brand-50">הפלטפורמה</a>
      <a href="/packages/" class="rounded-full border border-brand-200 px-4 py-2 font-medium text-brand-800 hover:bg-brand-50">חבילות</a>
      <a href="/contact/" class="rounded-full border border-brand-200 px-4 py-2 font-medium text-brand-800 hover:bg-brand-50">תיאום הדגמה</a>
    </nav>
  </section>
</BaseLayout>
