---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';

const principles = [
  {
    title: 'מהשטח, לא מהמעבדה',
    body: 'הפלטפורמה נבנית מתוך עבודה יומיומית עם סוכנויות ביטוח, משרדי תכנון פיננסי וניהול עושר בישראל, ומשתנה לפי מה שבאמת חוסך להם זמן.',
  },
  {
    title: 'בלי הבטחות באוויר',
    body: 'אנחנו מראים מה המערכת עושה, ואומרים בפירוש מה היא לא עושה. אין תחליף לשיקול הדעת המקצועי שלכם.',
  },
  {
    title: 'הנתונים הם שלכם',
    body: 'המידע של הלקוחות נשאר בסביבת העבודה של המשרד ומשמש אך ורק לצרכיו.',
  },
];
---

<BaseLayout
  title="אודות Plan-T"
  description="מי אנחנו: פלטפורמה ישראלית שנבנית יחד עם סוכני ביטוח, מתכננים פיננסיים ומנהלי עושר."
>
  <!-- M3 — same artwork family and treatment as the webinar strip, so the
       site's two photographic moments read as one brand. Decorative: empty alt. -->
  <section class="relative isolate overflow-hidden bg-brand-50 text-ink-900">
    <picture>
      <source srcset="/images/mood-growth-wide.webp" type="image/webp" />
      <img
        src="/images/mood-growth-wide.jpg"
        alt=""
        width="1920"
        height="847"
        loading="eager"
        decoding="async"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        aria-hidden="true"
      />
    </picture>
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-white/45 via-white/60 to-white/45" aria-hidden="true"></div>
    <div class="mx-auto max-w-4xl px-4 py-20 text-center md:py-24">
      <h1 class="text-4xl font-bold md:text-5xl">המקום שבו כל התמונה של הלקוח מתחברת.</h1>
      <p class="mt-5 text-lg text-ink-900">
        <span class="ltr">Plan-T</span> נבנית לסוכני ביטוח, למתכננים פיננסיים ולמנהלי עושר שרוצים לראות את הלקוח בתמונה רחבה יותר — בלי להוסיף עוד מורכבות ליום העבודה.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16">
    <!-- "הסיפור" and "החזון": migrated verbatim from the old site's מי אנחנו page
         (old-site-content.md L41–43, L50). MIGRATED — verify with Natali.
         Three claims inside are pending the deferred M-13 ruling and the
         forbidden-word rule, and are listed line-by-line in the PR:
         «יועצים» (L41), «היחידה בישראל» (L41, L42), «למעלה מ-12 שנים» (L42). -->
    <h2 class="text-3xl font-bold text-ink-900">הסיפור</h2>
    <div class="mt-4 space-y-4 leading-relaxed text-ink-700">
      <p>
        פלאנטי (<span class="ltr">PLAN-T</span>) היא חברת פינטק ישראלית ותיקה, המובילה את תחום פתרונות הניהול לנותני שירותים בשוק הפיננסי והפנסיוני בישראל – בהם סוכנים פנסיוניים, מתכננים פיננסיים, מנהלי עושר, מתכנני פרישה, יועצים ומנהלי השקעות.
      </p>
      <p>
        הפלטפורמה שלנו הוקמה לפני למעלה מ-12 שנים כמענה לצורך מהותי בשוק: יצירת קונסולידציה מלאה של נכסי הלקוח והצגת תמונת מצב הוליסטית של החשיפות והאלוקציות בתיק ההשקעות. מאז ועד היום, הצורך הזה רק התגבר, ואנו גאים להיות החברה היחידה בישראל המאפשרת ניתוח כולל ומדויק של כלל נכסי התא המשפחתי או הלקוח הבודד – במקום אחד.
      </p>
      <p>
        המערכת פותחה בשיתוף פעולה הדוק עם המשתמשים עצמם, מתוך הבנה עמוקה של האתגרים היומיומיים שלהם. הגישה הזו מאפשרת לנו להגיב במהירות לשינויים בשוק ולהציע פתרונות חכמים ומדויקים המותאמים לצרכים האמיתיים של אנשי המקצוע.
      </p>
    </div>

    <h2 class="mt-12 text-3xl font-bold text-ink-900">החזון</h2>
    <p class="mt-4 leading-relaxed text-ink-700">
      להמשיך להוביל ולהנגיש ללקוחותינו פתרונות מתקדמים אשר יתנו מענה לאתגרים הרבים בשוק וזאת באמצעות פיתוח כלים חדשניים שיתנו לנותני השירותים יתרון תחרותי, ישפרו את חוויית הלקוח הסופי.
    </p>

    <h2 class="mt-12 text-3xl font-bold text-ink-900">מה מנחה אותנו</h2>
    <div class="mt-6 grid gap-5">
      {
        principles.map((item) => (
          <article class="reveal card-lift rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold text-ink-900">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-700">{item.body}</p>
          </article>
        ))
      }
    </div>

    <!-- "הצוות": the three managers from the old site's הנהלת החברה block
         (old-site-content.md L52–60). Names, roles and emails verbatim; no
         photos, because none were supplied. MIGRATED — verify with Natali. -->
    <h2 class="mt-12 text-3xl font-bold text-ink-900">הצוות</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-3">
      {
        [
          { name: 'עידן בן נאים', role: 'מנכ"ל', email: 'Idan@plan-t.org.il' },
          { name: 'ליהי לוטן', role: 'סמנכ"לית מוצר ולקוחות', email: 'Lihi@plan-t.org.il' },
          { name: 'מור רפאל', role: 'סמנכ"לית טכנולוגיות', email: 'Mor@plan-t.org.il' },
        ].map((person) => (
          <li class="reveal card-lift rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
            <p class="text-lg font-bold text-ink-900">{person.name}</p>
            <p class="mt-1 text-ink-700">{person.role}</p>
            <a href={`mailto:${person.email}`} class="ltr mt-3 inline-block text-sm text-brand-700 underline hover:text-brand-600">{person.email}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <LeadForm source="website-about" heading="רוצים להכיר מקרוב?" />
</BaseLayout>
