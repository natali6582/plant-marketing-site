---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';
---

<BaseLayout
  title="יצירת קשר ותיאום הדגמה | Plan-T"
  description="השאירו פרטים ונחזור אליכם לתיאום הדגמה של Plan-T, או כתבו לנו ישירות בדוא״ל."
>
  <PageHero size="compact" seed={2}>
    <Fragment slot="title">בואו נדבר</Fragment>
    <Fragment slot="lead">
      השאירו פרטים ונחזור אליכם תוך יום עסקים אחד לתיאום הדגמה קצרה.
    </Fragment>
  </PageHero>

  <section class="band bg-surface-blue">
    <div class="mx-auto max-w-4xl px-4">
    <div class="grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border border-brand-200 bg-white hover:border-brand-400 p-6 shadow-sm">
        <h2 class="text-lg font-bold text-brand-800">דוא״ל</h2>
        <p class="mt-2">
          <a href="mailto:sales@plan-t.org.il" class="ltr font-medium text-brand-600 underline hover:text-brand-800">sales@plan-t.org.il</a>
        </p>
      </div>
      <div class="rounded-2xl border border-brand-200 bg-white hover:border-brand-400 p-6 shadow-sm">
        <h2 class="text-lg font-bold text-brand-800">טלפון</h2>
        <p class="mt-2">
          <a href="tel:+972733861711" class="ltr font-medium text-brand-600 underline hover:text-brand-800">073-3861711</a>
        </p>
      </div>
    </div>
    </div>
  </section>

  <LeadForm source="website-contact" heading="השאירו פרטים" />
</BaseLayout>
