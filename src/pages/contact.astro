---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
---

<BaseLayout
  title="יצירת קשר ותיאום הדגמה | Plan-T"
  description="השאירו פרטים ונחזור אליכם לתיאום הדגמה של Plan-T, או כתבו לנו ישירות בדוא״ל."
>
  <section class="bg-ink-900 text-white">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center">
      <h1 class="text-4xl font-bold md:text-5xl">בואו נדבר</h1>
      <p class="mt-5 text-lg text-ink-200">
        השאירו פרטים ונחזור אליכם תוך יום עסקים אחד לתיאום הדגמה קצרה.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12">
    <div class="grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-bold text-ink-900">דוא״ל</h2>
        <p class="mt-2">
          <a href="mailto:sales@plan-t.org.il" class="ltr font-medium text-brand-700 underline">sales@plan-t.org.il</a>
        </p>
      </div>
      <div class="rounded-2xl border border-brand-100 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-bold text-ink-900">טלפון</h2>
        <p class="mt-2">
          <a href="tel:+972733861711" class="ltr font-medium text-brand-700 underline">073-3861711</a>
        </p>
      </div>
    </div>
  </section>

  <LeadForm source="website-contact" heading="השאירו פרטים" />
</BaseLayout>
