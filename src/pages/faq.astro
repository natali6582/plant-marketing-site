---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';

/*
  /faq/ — the old site's שאלות-ותשובות page.

  The answers were migrated verbatim from Natali's export of 02/09/2026 and
  rewritten into the site's voice on 04/09/2026, approved by her line by line.
  The rewrite is voice only: every idea, number, name and list survives intact.
  Nothing was added and nothing was dropped. The before/after sat in a
  question-by-question table with a note on each change, and that table is the
  record of what was approved — it is quoted in the PR.

  Three wordings are deliberately untouched, because they were already ruled
  on: «ניהול תיקים» in Q3, «יועצים» in Q7, and Q8's closing superlative
  («המקיפה ביותר בשוק»), which is listed under M-13 and still deferred.

  The one line that is not a rewrite of an existing sentence is Q4's closing
  «ולא במסך נפרד» — it states explicitly what «לשלב… לצד יתר הנכסים» already
  said, and Natali approved it as such.

  Accordion = native <details>/<summary>: keyboard-operable, announced by
  screen readers, no script, no library. All eight answers are present, so the
  prompt's "do not merge with missing answers" condition is met.

  The questions sit in a real <ol>, and the number is a CSS counter rather than
  markup — see .faq-question::before in global.css for the RTL reason. Nothing
  here renders the index, so the numbering cannot drift from the list order.
*/
const faq = [
  {
    q: 'למה לעבור ל-PLAN-T?',
    a: [
      'אם המערכת שאתם עובדים איתה היום עונה על כל הצרכים שלכם ושל הלקוחות — כולל אלה שאתם צופים שיגיעו — אין לכם סיבה אמיתית לעבור. נגיד את זה בפירוש.',
      'ואם אתם רוצים כלים חדשניים יותר: לתת ללקוח ערך אמיתי בבחירת ההשקעות מתוך היכרות מעמיקה עם התיק הקיים, לשדרג את הדוחות ואת הנראות שלכם מול הלקוח, להקל על התפעול של המשרד ולאפשר לכם למכור יותר ולגדול — כדאי לבחון מעבר.',
      'מה שהמשתמשים מספרים: המעבר אפשר להם להגדיל את התיק הפיננסי. השיח נעשה מקצועי יותר, וכך קל יותר לזהות הזדמנויות ולמכור פיננסי. חלקם מספרים שחשיפת הלקוחות לדוחות שלנו הגדילה את האמון, והלקוח חשף השקעות נוספות ואף צירף בני משפחה.',
      'ומעבר לזה — הטכנולוגיות המתקדמות ביותר מונגשות לכם בתוך המוצר. זה לא משהו שתצטרכו לרדוף אחריו.',
    ],
  },
  {
    q: 'החלטתי לעבור. איך עובר כל המידע מהמערכת הקיימת?',
    a: [
      'תהליך מסודר, בליווי צוות ההטמעה שלנו לכל אורכו.',
      'מתחילים בפגישת אפיון קצרה: באילו מערכות אתם עובדים היום, ואיזה מידע חשוב לכם להעביר. משם אנחנו מקבלים קבצי גיבוי או קבצי אקסל מהמערכת הקיימת, וקולטים ומטמיעים את הנתונים. במקרים רבים אנחנו יודעים לקלוט נתונים ממערכות שונות, וזה מקצר את המעבר משמעותית.',
      'לאורך כל הדרך אנחנו איתכם: בדיקות תקינות, עזרה בהגדרות הראשוניות, ווידוא שהמידע זמין ומאורגן נכון במערכת החדשה. המטרה היא מעבר חלק ומהיר — בלי להקליד שום דבר מחדש.',
    ],
  },
  {
    q: 'באילו קבצים וממשקי מידע אתם תומכים?',
    a: [
      'במגוון רחב של מקורות וממשקי קליטה. אפשר לטעון קבצים ממערכות שונות — קבצי Excel וקבצים ייעודיים של יצרנים וגופים פיננסיים — ולקלוט נתונים ממקורות כמו מסלקה פנסיונית, הר הביטוח, בנקים, מערכות ניהול תיקים ומוצרים אלטרנטיביים.',
      'המערכת נבנתה לעבוד עם קליטות רחבות מגופים בארץ ובחו"ל, וכל זה לתכלית אחת: תמונה פיננסית מלאה ומאוחדת של הלקוח, במקום אחד.',
    ],
  },
  {
    q: 'האם המערכת מחוברת למסלקה הפנסיונית?',
    a: [
      'כן. יש ל-PLAN-T חיבור למסלקה הפנסיונית, שמאפשר קליטה ועיבוד של מידע פנסיוני כחלק מהתמונה הכוללת של הלקוח.',
      'זה אחד המרכיבים המרכזיים במערכת: הנתונים הפנסיוניים יושבים לצד יתר הנכסים, הביטוחים וההשקעות של הלקוח, בתוך תהליך התכנון הפיננסי — ולא במסך נפרד.',
    ],
  },
  {
    q: 'מה רמת אבטחת המידע?',
    a: [
      'אבטחת מידע ופרטיות הלקוחות הן בראש סדר העדיפויות שלנו.',
      'המערכת פועלת לפי דרישות האבטחה המחמירות הנדרשות בעולם הפיננסי, ובפרט לעבודה מול גורמים כמו המסלקה הפנסיונית. המידע נשמר ומועבר במנגנוני אבטחה והצפנה מתקדמים, עם בקרות גישה והרשאות. גם תהליכי העבודה שלנו נבנו כך — סודיות, אמינות וזמינות המידע לאורך כל מחזור החיים שלו.',
    ],
  },
  {
    q: 'האם יש ללקוחות שלי פורטל אישי?',
    a: [
      'כן. ל-PLAN-T יש פורטל לקוח אינטראקטיבי, שבו הלקוחות שלכם רואים את המידע הרלוונטי עבורם בצורה נוחה ודיגיטלית.',
      'הפורטל הוא ערוץ תקשורת נוסף מולם: חוויית שירות מתקדמת, מתוך שקיפות ונגישות למידע.',
    ],
  },
  {
    q: 'מה כל כך מיוחד בדוחות של PLAN-T?',
    a: [
      'הם נבנו במיוחד עבור יועצים, סוכנים ומתכננים פיננסיים שרוצים להציג ללקוח תמונה מקצועית, ברורה ומרשימה.',
      'המערכת מפיקה דוחות ומצגות מעוצבים ב-PDF, ומרכזת במקום אחד מידע על השקעות, פנסיה, ביטוחים, ביצועים, חשיפות, תכנון פיננסי ותובנות נוספות. במקום אוסף נתונים מפוזרים בכמה מערכות, הלקוח מקבל תמונה אחת ברורה — כזו שמסייעת בקבלת החלטות ומחזקת את הערך המקצועי של המתכנן הפיננסי.',
    ],
  },
  {
    q: 'מה הוליסטי במערכת? מדוע היא נתפסת כמערכת היחידה לתכנון פיננסי?',
    a: [
      'כי היא מרכזת במקום אחד את כלל עולמות התוכן שהמתכנן הפיננסי צריך: CRM, ניהול לקוחות, נכסים והתחייבויות, תכנון פיננסי, פנסיה, ביטוחים, השקעות, ניתוח תשואות, ניתוח עלויות, דוחות, פורטל לקוח וחיבור למסלקה הפנסיונית.',
      'זה נותן מבט 360° על הלקוח ועל התא המשפחתי, ומאפשר לקבל החלטות מתוך תמונה מלאה — לא מתוך מידע חלקי. במקום כמה מערכות שכל אחת מנהלת חלק אחר מהמידע, הכול מאוגד בפלטפורמה אחת אחידה, ולכן היא נתפסת בעיני רבים כמערכת התכנון הפיננסי המקיפה ביותר בשוק.',
    ],
  },
];
---

<BaseLayout
  title="שאלות ותשובות | Plan-T"
  description="תשובות לשאלות הנפוצות על Plan-T: תהליך המעבר, ממשקי המידע הנתמכים, החיבור למסלקה הפנסיונית, אבטחת מידע, פורטל הלקוח והדוחות."
>
  <PageHero size="compact" seed={3}>
    <Fragment slot="title">שאלות ותשובות</Fragment>
  </PageHero>

  <section class="band bg-white" aria-labelledby="faq-title">
    <div class="mx-auto max-w-3xl px-4">
      <h2 id="faq-title" class="sr-only">השאלות הנפוצות</h2>
      <ol class="faq-list space-y-3">
        {
          faq.map((item) => (
            <li class="faq-item">
              <details class="reveal card-lift group rounded-2xl border border-brand-200 bg-white hover:border-brand-400 shadow-sm open:border-brand-300">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-lg font-bold text-ink-900 [&::-webkit-details-marker]:hidden">
                  <span class="faq-question">{item.q}</span>
                  <span class="shrink-0 text-brand-600 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
                </summary>
                <div class="space-y-4 px-5 pb-5 leading-relaxed text-ink-700">
                  {item.a.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </details>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <LeadForm source="website-faq" audience="" heading="לא מצאתם את התשובה? נשמח לענות אישית." />
</BaseLayout>
