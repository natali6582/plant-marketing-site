---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';

/*
  /faq/ — the old site's שאלות-ותשובות page. Eight questions in the old order;
  Q1's answer comes from the old page itself, Q2–Q8 from Natali's export of
  02/09/2026 (old-site-content.md, "FAQ — answers (N-1)"). All verbatim.
  MIGRATED — verify with Natali.

  Two wording exceptions were ruled on 02/09 and stay as written: «ניהול תיקים»
  in Q3 and «יועצים» in Q7. Q8's closing superlative («המקיפה ביותר בשוק»)
  is listed under M-13, which is deferred.

  Accordion = native <details>/<summary>: keyboard-operable, announced by
  screen readers, no script, no library. All eight answers are present, so the
  prompt's "do not merge with missing answers" condition is met.
*/
const faq = [
  {
    q: 'למה כדאי לי לבחור ב-PLAN-T?',
    a: [
      'אם המערכת שאתה עובד איתה היום נותנת לך וללקוחות שלך מענה לכל הצרכים לרבות, אלו שלדעתך עתידים לבוא, אז אין לך סיבה אמיתית לעבור.',
      'אבל אם אתה רוצה להתקדם לכלים יותר חדשניים, לתת ערך אמיתי ללקוח בבחירת ההשקעות שלו תוך הכרות מעמיקה עם התיק הנוכחי, לשדרג את הדוחות שלך והנראות שלך אל מול הלקוח להקל על התפעול של המשרד ולאפשר לך למכור יותר ולגדול, כדאי לך מאוד ואף מומלץ לבחון מעבר למערכת PLAN T.',
      'המשתמשים מספרים שהמעבר אפשר להם להגדיל את התיק הפיננסי שלהם. השיח שלהם נהיה יותר מקצועי וכך יותר קל להם לזהות הזדמנויות ולמכור פיננסי. חלקם מספרים שחשיפת הלקוחות לדוחות שלנו הגדילה את האמון עם הלקוח שחשף השקעות נוספות ואף צירף בני משפחה.',
      'אפשר להפסיק להיות מוטרד! אצלנו תהיה בטוח שהטכנולוגיות המתקדמות ביותר יונגשו לך במוצר שלנו.',
    ],
  },
  {
    q: 'במידה והחלטתי לעבור אליכם, מה התהליך ואיך מעבירים את כל המידע מהמערכת הקיימת?',
    a: [
      'המעבר ל-PLAN-T הוא תהליך מסודר ומלווה על ידי צוות ההטמעה שלנו. בשלב הראשון אנו מבצעים פגישת אפיון קצרה כדי להבין באילו מערכות אתם עובדים כיום ואילו נתונים חשוב לכם להעביר. לאחר מכן אנו מקבלים קבצי גיבוי או קבצי אקסל מהמערכת הקיימת, ומבצעים קליטה והטמעה של הנתונים במערכת. במקרים רבים אנו יודעים לקלוט נתונים ממערכות שונות ולהקל משמעותית על תהליך המעבר. לאורך כל התהליך אנו מלווים אתכם, מבצעים בדיקות תקינות, מסייעים בהגדרות הראשוניות ומוודאים שהמידע זמין ומאורגן בצורה נכונה במערכת החדשה. המטרה היא לאפשר מעבר חלק ומהיר, ללא צורך בהקלדת הנתונים מחדש.',
    ],
  },
  {
    q: 'באיזה קבצי וממשקי מידע אתם תומכים?',
    a: [
      'PLAN-T תומכת במגוון רחב של מקורות מידע וממשקי קליטה. ניתן לטעון קבצים ממערכות שונות באמצעות קבצי Excel וקבצים ייעודיים של יצרנים וגופים פיננסיים, וכן לקלוט נתונים ממקורות כגון מסלקה פנסיונית, הר הביטוח, בנקים, מערכות ניהול תיקים ומוצרים אלטרנטיביים. המערכת נבנתה כך שתוכל לעבוד עם קליטות רחבות של נתונים מגופים בארץ ובחו"ל, במטרה ליצור תמונה פיננסית מלאה ומאוחדת של הלקוח במקום אחד.',
    ],
  },
  {
    q: 'האם המערכת מחוברת למסלקה הפנסיונית?',
    a: [
      'כן. ל-PLAN-T קיים חיבור למסלקה הפנסיונית, המאפשר קליטה ועיבוד של מידע פנסיוני כחלק מהתמונה הכוללת של הלקוח. החיבור למסלקה הוא אחד המרכיבים המרכזיים במערכת ומאפשר לשלב את הנתונים הפנסיוניים לצד יתר הנכסים, הביטוחים וההשקעות של הלקוח במסגרת תהליך התכנון הפיננסי.',
    ],
  },
  {
    q: 'מה רמת אבטחת המידע?',
    a: [
      'אנחנו מייחסים חשיבות עליונה לאבטחת מידע ולשמירה על פרטיות הלקוחות. המערכת פועלת בהתאם לדרישות האבטחה המחמירות הנדרשות בעולם הפיננסי, ובפרט לעבודה מול גורמים כגון המסלקה הפנסיונית. המידע נשמר ומועבר באמצעות מנגנוני אבטחה והצפנה מתקדמים, תוך הקפדה על בקרות גישה והרשאות. בנוסף, תהליכי העבודה שלנו נבנו כך שיאפשרו שמירה על סודיות, אמינות וזמינות המידע לאורך כל מחזור החיים שלו.',
    ],
  },
  {
    q: 'האם יש ללקוחות שלי פורטל אישי?',
    a: [
      'בהחלט. ל-PLAN-T יש פורטל לקוח אינטראקטיבי המאפשר ללקוחות לצפות במידע הרלוונטי עבורם בצורה נוחה ודיגיטלית. הפורטל מהווה ערוץ תקשורת נוסף מול הלקוח ומאפשר חוויית שירות מתקדמת, תוך שמירה על שקיפות ונגישות למידע.',
    ],
  },
  {
    q: 'מה כל כך מיוחד בדוחות של PLAN-T?',
    a: [
      'הדוחות של PLAN-T נבנו במיוחד עבור יועצים, סוכנים ומתכננים פיננסיים שמעוניינים להציג ללקוחות תמונה מקצועית, ברורה ומרשימה. המערכת מפיקה דוחות ומצגות מעוצבים בפורמט PDF ומרכזת במקום אחד מידע על השקעות, פנסיה, ביטוחים, ביצועים, חשיפות, תכנון פיננסי ותובנות נוספות. במקום אוסף נתונים מפוזרים ממספר מערכות, הלקוח מקבל תמונה ברורה והוליסטית שמסייעת בקבלת החלטות ומחזקת את הערך המקצועי של המתכנן הפיננסי.',
    ],
  },
  {
    q: 'מה הוליסטי במערכת? מדוע היא נתפסת כמערכת היחידה לתכנון פיננסי?',
    a: [
      'PLAN-T נתפסת כמערכת הוליסטית משום שהיא מרכזת במקום אחד את כלל עולמות התוכן שהמתכנן הפיננסי צריך: CRM, ניהול לקוחות, נכסים והתחייבויות, תכנון פיננסי, פנסיה, ביטוחים, השקעות, ניתוח תשואות, ניתוח עלויות, דוחות, פורטל לקוח וחיבור למסלקה הפנסיונית. המערכת מספקת מבט 360° על הלקוח ועל התא המשפחתי, ומאפשרת לקבל החלטות מתוך תמונה מלאה ולא מתוך מידע חלקי. במקום לעבוד עם מספר מערכות שונות שמנהלות חלקים נפרדים מהמידע, PLAN-T מאגדת את הכול לפלטפורמה אחת אחידה, ולכן היא נתפסת בעיני רבים כמערכת התכנון הפיננסי המקיפה ביותר בשוק.',
    ],
  },
];
---

<BaseLayout
  title="שאלות ותשובות | Plan-T"
  description="תשובות לשאלות הנפוצות על Plan-T: תהליך המעבר, ממשקי המידע הנתמכים, החיבור למסלקה הפנסיונית, אבטחת מידע, פורטל הלקוח והדוחות."
>
  <PageHero size="compact" seed={3} cta={{ label: 'תיאום הדגמה', href: '#lead-form' }}>
    <Fragment slot="title">שאלות ותשובות</Fragment>
  </PageHero>

  <section class="band bg-white" aria-labelledby="faq-title">
    <div class="mx-auto max-w-3xl px-4">
      <h2 id="faq-title" class="sr-only">השאלות הנפוצות</h2>
      <div class="space-y-3">
        {
          faq.map((item, index) => (
            <details class="reveal card-lift group rounded-2xl border border-brand-200 bg-white hover:border-brand-400 shadow-sm open:border-brand-300">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-lg font-bold text-ink-900 [&::-webkit-details-marker]:hidden">
                <span><span class="ltr me-2 text-brand-600">{index + 1}.</span>{item.q}</span>
                <span class="shrink-0 text-brand-600 transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
              </summary>
              <div class="space-y-4 px-5 pb-5 leading-relaxed text-ink-700">
                {item.a.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <LeadForm source="website-faq" audience="" heading="לא מצאתם את התשובה? נשמח לענות אישית." />
</BaseLayout>
