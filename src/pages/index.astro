---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';
import Marquee from '../components/Marquee.astro';
import BokehBackground from '../components/BokehBackground.astro';
import TeaserBand from '../components/TeaserBand.astro';
import DuotoneIcon from '../components/DuotoneIcon.astro';
import StatsRow from '../components/StatsRow.astro';
import AudienceSelector from '../components/AudienceSelector.astro';
import { advantages } from '../data/advantages';

const painCards = [
  {
    icon: 'hourglass',
    title: 'הכאב: שעות על ניירת',
    body: 'איסוף מסמכים, הקלדות כפולות ומעקב ידני אחרי כל לקוח גוזלים את הזמן שהיה אמור ללכת ללקוח עצמו.',
  },
  {
    icon: 'puzzle',
    title: 'הכאב: תמונה חלקית',
    body: 'המידע הפנסיוני והפיננסי של הלקוח מפוזר בין מסלקה, יצרנים וגיליונות — וקשה לבנות ממנו תמונה אחת שלמה.',
  },
  {
    icon: 'check-circle',
    title: 'הדרך של Plan-T',
    body: 'פלטפורמה אחת שמרכזת את הנתונים, מסדרת את התהליך ומשאירה לכם את מה שחשוב: השיחה עם הלקוח וההחלטות המקצועיות.',
  },
];

/*
  Product tour. The first two are the real screenshots published in the
  מסכי המערכת gallery on plan-t.org.il; `webp` is served with a jpg fallback.
  The third is a screen capture Natali supplied on 03/09/2026 — the automatic-
  reports settings dialog. It is not from the published gallery; see the PR.

  The fourth and fifth are captures Natali supplied on 04/09/2026 — sales-
  pipeline analysis and the client list. Plain rectangular crops, downscaled
  to the same 1400px width; nothing in them is blurred, painted over or
  invented. The crop lines were placed in measured gaps between content bands,
  which is also why the period tabs are missing from the sales screen and the
  filter row from the client screen: the floating "+" button overlaps both,
  and no rectangle removes the button without taking the row with it.

  DRAFT — captions and alt text need Natali's approval, and the screenshots
  carry live-looking figures (client counts, portfolio totals). They must not
  ship until she confirms the source is a demo environment. See the PR.

  Order is the tour's argument: one client, then the office, then what the
  office sends out, then the pipeline behind it, then the book it all runs on.
*/
const tour = [
  {
    image: '/images/tour-client',
    formats: ['webp', 'jpg'],
    width: 1400,
    height: 1073,
    alt: 'מסך לקוח ראשי ב-Plan-T: פרטי הלקוח, תשואת התיק, מאזן נכסים, פילוח נכסים וסיכונים וחשיפות במסך אחד',
    caption: 'מסך לקוח ראשי — כל התיק במקום אחד.',
  },
  {
    image: '/images/tour-main',
    formats: ['webp', 'jpg'],
    width: 1209,
    height: 910,
    alt: 'מסך ראשי ב-Plan-T: פעולות פתוחות ולידים, שווי נכסים כולל, פילוח נכסים, חשיפות ועדכוני מערכת',
    caption: 'מסך ראשי — התמונה המלאה של המשרד.',
  },
  {
    image: '/images/tour-reports-auto',
    formats: ['webp', 'jpg'],
    width: 1111,
    height: 497,
    alt: 'מסך הדוחות האוטומטיים ב-Plan-T: חלון סיכום ההגדרות של דוח תשואה — מועד השליחה, פירוט ההגדרות לכל דוח ואישור לפני ההפעלה',
    caption: 'דוח ללקוח בלחיצה — מסודר, ממותג ומוכן לשליחה.',
  },
  {
    image: '/images/tour-sales',
    formats: ['webp', 'jpg'],
    width: 1400,
    height: 367,
    alt: 'מסך ניתוח תהליכי מכירה ב-Plan-T: מספר לקוחות וסך נכסים, ומצב נוכחי של פעולות, לידים, הזדמנויות מכירה, משימות ופגישות',
    caption: 'ניתוח תהליכי מכירה — הלידים, ההזדמנויות והפעולות של המשרד במבט אחד.',
  },
  {
    image: '/images/tour-clients',
    formats: ['webp', 'jpg'],
    width: 1400,
    height: 335,
    /* The filters are not in the frame — see the crop note above — so neither
       the alt nor the caption claims them. Both describe the six tiles that
       are actually visible, and neither repeats a figure from the screen. */
    alt: 'מסך "הלקוחות שלי" ב-Plan-T: פעילים, פוטנציאליים ולא פעילים, כשירים, הצטרפו החודש וגיל ממוצע',
    caption: 'הלקוחות שלי — פעילים, פוטנציאליים ולא פעילים, במבט אחד.',
  },
];
---

<BaseLayout
  title="Plan-T — כל התמונה של הלקוח, במקום אחד"
  description="Plan-T מרכזת במקום אחד את נתוני הנכסים הפיננסיים והפנסיוניים של הלקוח, ומאפשרת לסוכני ביטוח, מתכננים פיננסיים ומנהלי עושר לראות את התיק בתמונה אחת ברורה."
>
  <!-- The hero every other page now opens with too. The band's bottom edge is
       clipped on a diagonal, mirrored from the measured Orion slope so it falls
       toward the right in RTL; that lives in .hero-slope, inside PageHero. -->
  <PageHero size="full" background="photo" image eyebrow="הפלטפורמה שרואה את כל התמונה של הלקוח">
    <Fragment slot="background">
      <!-- The photograph that used to sit behind the testimonial band; the two
           swapped places. Eager and high priority because it is above the fold
           and is now the page's LCP element. object-position keeps the three
           faces in frame when the band is cropped narrow on a phone.
           Decorative: the hero's own words carry the meaning. -->
      <picture>
        <source srcset="/images/mood-advisors.webp" type="image/webp" />
        <img
          src="/images/mood-advisors.jpg"
          alt=""
          width="1168"
          height="620"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 -z-10 h-full w-full object-cover [object-position:center_30%]"
          aria-hidden="true"
        />
      </picture>
      <!-- Legibility overlay. The photograph is bright and the type is white,
           so this is not decoration — the ratios in the PR are measured over
           the brightest pixel behind each line, with these exact stops. -->
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-b from-brand-900/75 via-brand-800/66 to-brand-700/56"
        aria-hidden="true"
      ></div>
    </Fragment>
    <Fragment slot="title">כל תיק הלקוח. תמונה אחת ברורה.</Fragment>
    <Fragment slot="lead">
      <span class="ltr">Plan-T</span> מרכזת את הנתונים הפיננסיים והפנסיוניים, מסדרת את תהליך
      העבודה ומאפשרת להתמקד בתכנון ובשיחה עם הלקוח.
    </Fragment>
    <Fragment slot="image">
      <!-- M1 — the product is the hero. Still eager, because it is above the
           fold, but no longer fetchpriority="high": the photograph behind the
           hero is now the larger painted element and therefore the LCP
           candidate, and two images both claiming high priority only make them
           compete. One high-priority image per page is the point of the hint.

           The browser chrome that framed the
           previous single screen is gone: this is a montage of floating panels
           with its own light ground, and a single address bar around it would
           claim it is one page when it is not. -->
      <div class="overflow-hidden rounded-2xl border border-brand-700 shadow-2xl shadow-brand-950/30">
        <picture>
          <source srcset="/images/hero-montage.webp" type="image/webp" />
          <img
            src="/images/hero-montage.jpg"
            alt="מסכי Plan-T: סיכום לקוחות, סקירת תיק, פעילות אחרונה, נתוני שוק והגדרות — ועליהם הכיתוב «כל התמונה של הלקוח. במקום אחד.»"
            width="1168"
            height="784"
            loading="eager"
            decoding="async"
            class="block w-full"
          />
        </picture>
      </div>
    </Fragment>
  </PageHero>

  <!-- The advantages strip, where Orion runs its logo marquee: the strip
       teases what /product/ explains in full. Swap `items` for cleared partner
       logos when there are any. Label and items are the approved product copy. -->
  <Marquee items={advantages} label="היתרונות המרכזיים" />

  <!-- D3 = KEEP: the marquee stays above the selector, so the page reads
       hero → advantages → "which of you is this for". -->
  <AudienceSelector />

  <!-- Renders nothing until src/data/stats.json holds real, sourced figures. -->
  <StatsRow />

  <!-- Pain → the Plan-T way -->
  <section class="band bg-white" aria-labelledby="pain-title">
    <div class="mx-auto max-w-6xl px-4">
    <h2 id="pain-title" class="reveal-lines text-center text-3xl font-bold text-brand-800">
      מכירים את זה מהמשרד שלכם?
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        painCards.map((card, i) => (
          <article
            class:list={[
              'reveal card-lift rounded-2xl border p-6 shadow-sm',
              i === 2 ? 'border-brand-700 bg-brand-700 text-white' : 'border-brand-100 bg-white',
            ]}
            data-band={i === 2 ? 'dark' : undefined}
          >
            <DuotoneIcon name={card.icon} size="md" />
            <h3 class="mt-4 text-xl font-bold">{card.title}</h3>
            <p class:list={['mt-3 leading-relaxed', i === 2 ? 'text-ink-200' : 'text-ink-700']}>{card.body}</p>
          </article>
        ))
      }
    </div>
    </div>
  </section>

  <!-- Product tour. Each figure is a card with the screenshot bled to its
       edge, so the image is part of the card rather than sitting on top of it. -->
  <section class="band bg-surface-blue" aria-labelledby="tour-title">
    <div class="mx-auto max-w-6xl px-4">
    <h2 id="tour-title" class="reveal-lines text-center text-3xl font-bold text-brand-800">סיור קצר במוצר</h2>
    <!--
      Option A: five cards, and the last row of two is centred rather than
      left as an orphan pair.

      Six columns with every card spanning two is the mechanism. It gives
      exactly the same three-up row as before, and the fourth card starting at
      column two puts the remaining pair in the middle at the same width as
      every other card — so the short row reads as a decision. On mobile the
      grid is a single column and none of this applies.
    -->
    <div class="mt-10 grid gap-8 md:grid-cols-6">
      {
        tour.map((item, index) => (
          <figure
            class:list={[
              'reveal card-lift overflow-hidden rounded-2xl border border-brand-200 bg-white hover:border-brand-400 shadow-sm',
              'md:col-span-2',
              index === 3 && 'md:col-start-2',
            ]}
          >
            <!-- M-12: lightbox on click. A real button, so Enter/Space work and
                 the target is announced; block + full width so wrapping the
                 image changes no layout. The alt travels to the dialog. -->
            <button
              type="button"
              class="lightbox-open block w-full cursor-zoom-in"
              data-src={item.formats ? `${item.image}.jpg` : item.image}
              data-alt={item.alt}
              aria-label={`הגדלת התמונה: ${item.caption}`}
            >
            {item.formats ? (
              <picture>
                <source srcset={`${item.image}.webp`} type="image/webp" />
                <img
                  src={`${item.image}.jpg`}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                  class="block w-full"
                />
              </picture>
            ) : (
              <img
                src={item.image}
                alt={item.alt}
                width="640"
                height="400"
                loading="lazy"
                decoding="async"
                class="block w-full"
              />
            )}
            </button>
            <figcaption class="px-5 py-4 text-center text-sm font-medium text-ink-700">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
    </div>
  </section>

  <!-- M-12 lightbox. One native <dialog> for all three tour images: showModal()
       gives the focus trap, aria-modal semantics, Esc-to-close and an inert
       page behind it for free — nothing to reimplement, nothing to get subtly
       wrong. Backdrop click and the close button are the two extras. The
       opener gets focus back on close. No entrance animation at all, so
       reduced motion has nothing to suppress and there is no layout shift:
       the dialog is out of flow. -->
  <dialog class="lightbox" aria-label="תצוגה מוגדלת של צילום המסך" data-lightbox>
    <button
      type="button"
      class="lightbox-close"
      aria-label="סגירת התצוגה המוגדלת"
      data-lightbox-close
    >
      <span aria-hidden="true">×</span>
    </button>
    <img src="" alt="" width="1400" height="1073" decoding="async" data-lightbox-img />
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-close]');

    if (dialog && image && closeButton && typeof dialog.showModal === 'function') {
      let opener: HTMLElement | null = null;

      for (const button of document.querySelectorAll<HTMLButtonElement>('.lightbox-open')) {
        button.addEventListener('click', () => {
          opener = button;
          image.src = button.dataset.src ?? '';
          // The alt is the image's meaning; it must survive the enlargement.
          image.alt = button.dataset.alt ?? '';
          dialog.showModal();
          closeButton.focus();
        });
      }

      closeButton.addEventListener('click', () => dialog.close());

      // A click on the backdrop lands on the <dialog> itself, not on a child.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      // Esc is native. On any close, hand focus back to where the visitor was.
      dialog.addEventListener('close', () => {
        image.src = '';
        opener?.focus();
        opener = null;
      });
    }
  </script>

  <!-- Social proof — one real, published testimonial from plan-t.org.il.
       Wording and punctuation are verbatim; only whitespace was normalised
       (the editor's stray non-breaking spaces and doubled spaces collapsed),
       and CRM is wrapped in .ltr like every other Latin string on the site.
       Do not reword, and add nothing that is not published. -->
  <section
    class="band relative isolate overflow-hidden bg-gradient-to-b from-brand-800 to-brand-700 bokeh-host text-white"
    data-band="dark"
    aria-labelledby="proof-title"
  >
    <!-- Seed 3 rather than 2: the lead-form band directly below is seed 3 too,
         but at half intensity on a much shorter band, so the two crops share no
         visible discs. Seed 1 is the hero's. -->
    <BokehBackground intensity="half" seed={3} />
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h2 id="proof-title" class="reveal-lines text-3xl font-bold text-white">משרדים שכבר עובדים איתנו</h2>
      <figure class="reveal reveal--float card-lift mt-8 rounded-2xl border border-brand-200 bg-white hover:border-brand-400 p-8 shadow-sm sm:p-10">
        <blockquote class="text-lg leading-relaxed text-ink-900 sm:text-xl">"סוף סוף מערכת שמרכזת הכל במקום אחד , <span class="ltr">CRM</span> :דוחות ללקוחות, ניהול חשיפות, תכנון פיננסי, תפעול ובקרה, – בלי קפיצות בין מערכות ובלי בזבוז זמן מיותר."</blockquote>
        <figcaption class="mt-6 text-sm font-bold text-brand-600">רווית, סוכנת ביטוח ופיננסים עצמאית</figcaption>
      </figure>
    </div>
  </section>

  <LeadForm source="website-home" />

  <!-- The agents teaser, in its slim form. Home carries the line and the link;
       the form lives on /agents/ where the rest of that story is. This is the
       only place the agent campaign's tone appears outside /agents/, and it is
       deliberately one strip, not a section. -->
  <TeaserBand variant="strip" />
</BaseLayout>
