---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import Marquee from '../components/Marquee.astro';
import StatsRow from '../components/StatsRow.astro';
import AudienceSelector from '../components/AudienceSelector.astro';
import { advantages } from '../data/advantages';

/*
  One icon per card, drawn inline so nothing new is fetched: a sheet of paper
  for the hours lost to it, a circle with a quadrant missing for the partial
  picture, a check for the way out. Decorative — each card's own heading says
  the same thing in words, so the icons are aria-hidden.
*/
const painIcons = [
  '<path d="M8 3h7l4 4v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M15 3v4h4"/><path d="M9 12h6"/><path d="M9 16h4"/>',
  '<path d="M21 12a9 9 0 1 1-9-9v9h9Z"/><path d="M15.5 3.6A9 9 0 0 1 20.4 8.5"/>',
  '<circle cx="12" cy="12" r="9"/><path d="m8.4 12.4 2.5 2.5 4.7-5.3"/>',
];

const painCards = [
  {
    title: 'הכאב: שעות על ניירת',
    body: 'איסוף מסמכים, הקלדות כפולות ומעקב ידני אחרי כל לקוח גוזלים את הזמן שהיה אמור ללכת ללקוח עצמו.',
  },
  {
    title: 'הכאב: תמונה חלקית',
    body: 'המידע הפנסיוני והפיננסי של הלקוח מפוזר בין מסלקה, יצרנים וגיליונות — וקשה לבנות ממנו תמונה אחת שלמה.',
  },
  {
    title: 'הדרך של Plan-T',
    body: 'פלטפורמה אחת שמרכזת את הנתונים, מסדרת את התהליך ומשאירה לכם את מה שחשוב: השיחה עם הלקוח וההחלטות המקצועיות.',
  },
];

/*
  Product tour. The first two are the real screenshots published in the
  מסכי המערכת gallery on plan-t.org.il; `webp` is served with a jpg fallback.
  The third slot is still a wireframe — the gallery publishes two screens, not
  three. Replace it when a third screenshot is approved.
*/
const tour = [
  {
    image: '/images/tour-client',
    formats: ['webp', 'jpg'],
    width: 1400,
    height: 1073,
    alt: 'מסך לקוח ראשי ב-Plan-T: פרטי הלקוח, תשואת התיק, מאזן נכסים, פילוח נכסים וסיכונים וחשיפות במסך אחד',
    caption: 'מסך לקוח ראשי — כל התיק במקום אחד.',
  },
  {
    image: '/images/tour-main',
    formats: ['webp', 'jpg'],
    width: 1209,
    height: 910,
    alt: 'מסך ראשי ב-Plan-T: פעולות פתוחות ולידים, שווי נכסים כולל, פילוח נכסים, חשיפות ועדכוני מערכת',
    caption: 'מסך ראשי — התמונה המלאה של המשרד.',
  },
  {
    image: '/images/tour-report.svg',
    alt: 'צילום מסך להמחשה: דוח מסודר ללקוח שהופק מ-Plan-T',
    caption: 'דוח ללקוח בלחיצה — מסודר, ממותג ומוכן לשליחה.',
  },
];
---

<BaseLayout
  title="Plan-T — כל התמונה של הלקוח, במקום אחד"
  description="Plan-T מרכזת במקום אחד את נתוני הנכסים הפיננסיים והפנסיוניים של הלקוח, ומאפשרת לסוכני ביטוח, מתכננים פיננסיים ומנהלי עושר לראות את התיק בתמונה אחת ברורה."
>
  <!-- Hero. The band's bottom edge is clipped on a diagonal, mirrored from
       the measured Orion slope so it falls toward the right in RTL. -->
  <section class="hero-slope bg-gradient-to-b from-white to-brand-100 text-ink-900">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center md:py-28">
      <p class="text-sm font-bold tracking-wide text-brand-700">הפלטפורמה שרואה את כל התמונה של הלקוח</p>
      <h1 class="reveal-lines mx-auto mt-4 max-w-3xl text-4xl font-bold leading-tight md:text-6xl">
        כל תיק הלקוח. תמונה אחת ברורה.
      </h1>
      <!-- Fades up on the base 20px, not the 60px float. This paragraph sits 40px
           above the demo button, so a 60px displacement drew it straight through
           the button for the length of the animation — the whole reason the float
           was visible at all here. Above-the-fold content has no scroll to enter
           on; it just arrives. -->
      <p class="reveal mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-700">
        <span class="ltr">Plan-T</span> מרכזת את הנתונים הפיננסיים והפנסיוניים, מסדרת את תהליך
        העבודה ומאפשרת להתמקד בתכנון ובשיחה עם הלקוח.
      </p>
      <a
        href="/contact/"
        class="btn-pill btn-solid mt-10 inline-block rounded-full px-10 py-4 text-lg font-bold text-ink-950"
      >
        תיאום הדגמה
      </a>

      <!-- M1 — the product is the hero. The browser chrome that framed the
           previous single screen is gone: this is a montage of floating panels
           with its own light ground, and a single address bar around it would
           claim it is one page when it is not. -->
      <div class="mx-auto mt-14 max-w-3xl md:mt-16">
        <div class="overflow-hidden rounded-2xl border border-brand-100 shadow-2xl shadow-brand-900/15">
          <picture>
            <source srcset="/images/hero-montage.webp" type="image/webp" />
            <img
              src="/images/hero-montage.jpg"
              alt="מסכי Plan-T: סיכום לקוחות, סקירת תיק, פעילות אחרונה, נתוני שוק והגדרות — ועליהם הכיתוב «כל התמונה של הלקוח. במקום אחד.»"
              width="1168"
              height="784"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="block w-full"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- The advantages strip, where Orion runs its logo marquee: the strip
       teases what /product/ explains in full. Swap `items` for cleared partner
       logos when there are any. Label and items are the approved product copy. -->
  <Marquee items={advantages} label="היתרונות המרכזיים" />

  <!-- D3 = KEEP: the marquee stays above the selector, so the page reads
       hero → advantages → "which of you is this for". -->
  <AudienceSelector />

  <!-- Renders nothing until src/data/stats.json holds real, sourced figures. -->
  <StatsRow />

  <!-- Pain → the Plan-T way -->
  <section class="band bg-white" aria-labelledby="pain-title">
    <div class="mx-auto max-w-6xl px-4">
    <h2 id="pain-title" class="reveal-lines text-center text-3xl font-bold text-ink-900">
      מכירים את זה מהמשרד שלכם?
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        painCards.map((card, i) => (
          <article
            class:list={[
              'reveal card-lift rounded-2xl border p-6 shadow-sm',
              i === 2 ? 'border-brand-700 bg-brand-700 text-white' : 'border-brand-100 bg-white',
            ]}
          >
            <span
              class:list={[
                'inline-flex h-11 w-11 items-center justify-center rounded-xl',
                i === 2 ? 'bg-white/15 text-white' : 'bg-brand-50 text-brand-700',
              ]}
              aria-hidden="true"
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={painIcons[i]}
              />
            </span>
            <h3 class="mt-4 text-xl font-bold">{card.title}</h3>
            <p class:list={['mt-3 leading-relaxed', i === 2 ? 'text-ink-200' : 'text-ink-700']}>{card.body}</p>
          </article>
        ))
      }
    </div>
    </div>
  </section>

  <!-- Product tour. Each figure is a card with the screenshot bled to its
       edge, so the image is part of the card rather than sitting on top of it. -->
  <section class="band bg-ink-50" aria-labelledby="tour-title">
    <div class="mx-auto max-w-6xl px-4">
    <h2 id="tour-title" class="reveal-lines text-center text-3xl font-bold text-ink-900">סיור קצר במוצר</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {
        tour.map((item) => (
          <figure class="reveal card-lift overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm">
            <!-- M-12: lightbox on click. A real button, so Enter/Space work and
                 the target is announced; block + full width so wrapping the
                 image changes no layout. The alt travels to the dialog. -->
            <button
              type="button"
              class="lightbox-open block w-full cursor-zoom-in"
              data-src={item.formats ? `${item.image}.jpg` : item.image}
              data-alt={item.alt}
              aria-label={`הגדלת התמונה: ${item.caption}`}
            >
            {item.formats ? (
              <picture>
                <source srcset={`${item.image}.webp`} type="image/webp" />
                <img
                  src={`${item.image}.jpg`}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                  class="block w-full"
                />
              </picture>
            ) : (
              <img
                src={item.image}
                alt={item.alt}
                width="640"
                height="400"
                loading="lazy"
                decoding="async"
                class="block w-full"
              />
            )}
            </button>
            <figcaption class="px-5 py-4 text-center text-sm font-medium text-ink-700">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
    </div>
  </section>

  <!-- M-12 lightbox. One native <dialog> for all three tour images: showModal()
       gives the focus trap, aria-modal semantics, Esc-to-close and an inert
       page behind it for free — nothing to reimplement, nothing to get subtly
       wrong. Backdrop click and the close button are the two extras. The
       opener gets focus back on close. No entrance animation at all, so
       reduced motion has nothing to suppress and there is no layout shift:
       the dialog is out of flow. -->
  <dialog class="lightbox" aria-label="תצוגה מוגדלת של צילום המסך" data-lightbox>
    <button
      type="button"
      class="lightbox-close"
      aria-label="סגירת התצוגה המוגדלת"
      data-lightbox-close
    >
      <span aria-hidden="true">×</span>
    </button>
    <img src="" alt="" width="1400" height="1073" decoding="async" data-lightbox-img />
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-close]');

    if (dialog && image && closeButton && typeof dialog.showModal === 'function') {
      let opener: HTMLElement | null = null;

      for (const button of document.querySelectorAll<HTMLButtonElement>('.lightbox-open')) {
        button.addEventListener('click', () => {
          opener = button;
          image.src = button.dataset.src ?? '';
          // The alt is the image's meaning; it must survive the enlargement.
          image.alt = button.dataset.alt ?? '';
          dialog.showModal();
          closeButton.focus();
        });
      }

      closeButton.addEventListener('click', () => dialog.close());

      // A click on the backdrop lands on the <dialog> itself, not on a child.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      // Esc is native. On any close, hand focus back to where the visitor was.
      dialog.addEventListener('close', () => {
        image.src = '';
        opener?.focus();
        opener = null;
      });
    }
  </script>

  <!-- Social proof — one real, published testimonial from plan-t.org.il.
       Wording and punctuation are verbatim; only whitespace was normalised
       (the editor's stray non-breaking spaces and doubled spaces collapsed),
       and CRM is wrapped in .ltr like every other Latin string on the site.
       Do not reword, and add nothing that is not published. -->
  <!-- The human beat the page was missing between the product tour and the
       quotation: a photograph shown as a photograph, not as scenery under a
       wash. Framed to the content width rather than bled to the window edge
       on purpose — the source is 884px wide, so full-bleed would upscale it
       past 1.6x on a desktop and show it. Inside this frame it is 1.3x, and
       the rounded frame echoes the montage in the hero. Replace the file with
       a wider original and the frame can come off. Decorative: the quotation
       below carries the meaning, so the alt is empty and the strip is hidden
       from assistive tech. -->
  <div class="bg-white pb-4 pt-12 md:pt-16" aria-hidden="true">
    <div class="mx-auto max-w-6xl px-4">
      <div class="overflow-hidden rounded-2xl border border-brand-100 shadow-lg shadow-brand-900/10">
        <picture>
          <source srcset="/images/mood-team.webp" type="image/webp" />
          <img
            src="/images/mood-team.jpg"
            alt=""
            width="884"
            height="232"
            loading="lazy"
            decoding="async"
            class="block h-44 w-full object-cover object-center md:h-56 lg:h-64"
          />
        </picture>
      </div>
    </div>
  </div>

  <section class="band relative isolate overflow-hidden bg-brand-50" aria-labelledby="proof-title">
    <!-- Decorative only: advisers at a table, under the white wash the rest of
         the mood imagery uses. Empty alt — the testimonial carries the meaning,
         the photograph only sets the room. -->
    <picture>
      <source srcset="/images/mood-advisors.webp" type="image/webp" />
      <img
        src="/images/mood-advisors.jpg"
        alt=""
        width="1168"
        height="620"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
        aria-hidden="true"
      />
    </picture>
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-white/45 via-white/60 to-white/45"
      aria-hidden="true"
    ></div>
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h2 id="proof-title" class="reveal-lines text-3xl font-bold text-ink-900">משרדים שכבר עובדים איתנו</h2>
      <figure class="reveal reveal--float card-lift mt-8 rounded-2xl border border-brand-100 bg-white p-8 shadow-sm sm:p-10">
        <blockquote class="text-lg leading-relaxed text-ink-900 sm:text-xl">"סוף סוף מערכת שמרכזת הכל במקום אחד , <span class="ltr">CRM</span> :דוחות ללקוחות, ניהול חשיפות, תכנון פיננסי, תפעול ובקרה, – בלי קפיצות בין מערכות ובלי בזבוז זמן מיותר."</blockquote>
        <figcaption class="mt-6 text-sm font-bold text-brand-700">רווית, סוכנת ביטוח ופיננסים עצמאית</figcaption>
      </figure>
    </div>
  </section>

  <LeadForm source="website-home" />
</BaseLayout>
