---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import WebinarStrip from '../components/WebinarStrip.astro';

const painCards = [
  {
    title: 'הכאב: שעות על ניירת',
    body: 'איסוף מסמכים, הקלדות כפולות ומעקב ידני אחרי כל לקוח גוזלים את הזמן שהיה אמור ללכת לייעוץ עצמו.',
  },
  {
    title: 'הכאב: תמונה חלקית',
    body: 'המידע הפנסיוני והפיננסי של הלקוח מפוזר בין מסלקה, יצרנים וגיליונות — וקשה לבנות ממנו תמונה אחת שלמה.',
  },
  {
    title: 'הדרך של Plan-T',
    body: 'פלטפורמה אחת שמרכזת את הנתונים, מסדרת את התהליך ומשאירה לכם את מה שחשוב: השיחה עם הלקוח וההחלטות המקצועיות.',
  },
];

const aiCards = [
  { title: 'תמצות תיק לקוח', body: 'תמונה מרוכזת של התיק בשפה פשוטה, מוכנה לפני כל פגישה.' },
  { title: 'טיוטת סיכום פגישה', body: 'סיכום מובנה של השיחה, לעריכה ואישור שלכם לפני שליחה.' },
  { title: 'איתור פערים', body: 'סימון פערי כיסוי ונקודות לבדיקה בתיק — ההחלטה תמיד אצלכם.' },
  { title: 'מענה מהיר למסמכים', body: 'שאלות חופשיות על מסמכי הלקוח ותשובות עם הפניה למקור.' },
  { title: 'הכנה לשיחת שירות', body: 'נקודות עיקריות והיסטוריית פניות מרוכזות לפני כל שיחה.' },
  { title: 'שקיפות ובקרה', body: 'כל תוצר AI מסומן, ניתן למעקב וכפוף לאישור אנושי — בלי קסמים.' },
];

/*
  Product tour. The first two are the real screenshots published in the
  מסכי המערכת gallery on plan-t.org.il; `webp` is served with a jpg fallback.
  The third slot is still a wireframe — the gallery publishes two screens, not
  three. Replace it when a third screenshot is approved.
*/
const tour = [
  {
    image: '/images/tour-client',
    formats: ['webp', 'jpg'],
    width: 1400,
    height: 1073,
    alt: 'מסך לקוח ראשי ב-Plan-T: פרטי הלקוח, תשואת התיק, מאזן נכסים, פילוח נכסים וסיכונים וחשיפות במסך אחד',
    caption: 'מסך לקוח ראשי — כל התיק במקום אחד.',
  },
  {
    image: '/images/tour-main',
    formats: ['webp', 'jpg'],
    width: 1209,
    height: 910,
    alt: 'מסך ראשי ב-Plan-T: פעולות פתוחות ולידים, שווי נכסים כולל, פילוח נכסים, חשיפות ועדכוני מערכת',
    caption: 'מסך ראשי — התמונה המלאה של המשרד.',
  },
  {
    image: '/images/tour-report.svg',
    alt: 'צילום מסך להמחשה: דוח מסודר ללקוח שהופק מ-Plan-T',
    caption: 'דוח ללקוח בלחיצה — מסודר, ממותג ומוכן לשליחה.',
  },
];
---

<BaseLayout
  title="Plan-T — הפלטפורמה ליועצים, סוכנים ומתכננים פיננסיים"
  description="אל תישאר מאחור. תתקדם ל-Plan-t: פלטפורמה ישראלית ליועצים פיננסיים, סוכני ביטוח ויועצים פנסיוניים, עם Plan-t AI שחוסך שעות עבודה בכל תיק."
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-ink-950 to-ink-800 text-white">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center md:py-28">
      <p class="text-sm font-bold tracking-wide text-accent-300">מסוכן למתכנן</p>
      <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-black leading-tight md:text-6xl">
        <span class="block">אל תישאר מאחור.</span>
        <span class="mt-2 block text-accent-300">תתקדם ל־<span class="ltr">Plan-t</span></span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-200">
        פלטפורמה אחת ליועצים פיננסיים, סוכני ביטוח ויועצים פנסיוניים —
        שמרכזת את תיק הלקוח, מסדרת את העבודה ומחזירה לכם שעות בכל שבוע.
      </p>
      <a
        href="/contact/"
        class="mt-10 inline-block rounded-full bg-accent-500 px-10 py-4 text-lg font-bold text-ink-950 transition-colors hover:bg-accent-400"
      >
        תיאום הדגמה
      </a>

      <!-- M1 — the product is the hero: the charts side of the verified-demo
           client screen in a browser frame. Interim crop: the full capture has
           a broken flag-icon slot in the client panel, so the hero shows only
           the charts columns until a fresh capture is supplied. -->
      <div class="mx-auto mt-14 max-w-2xl md:mt-16">
        <div class="overflow-hidden rounded-xl border border-ink-700 bg-ink-800 shadow-2xl shadow-ink-950/60">
          <div class="flex items-center gap-1.5 border-b border-ink-700 bg-ink-800 px-4 py-2.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-ink-500"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-ink-500"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-ink-500"></span>
            <span class="ltr ms-3 text-xs text-ink-300">plan-t.co.il</span>
          </div>
          <picture>
            <source srcset="/images/hero-client-charts.webp" type="image/webp" />
            <img
              src="/images/hero-client-charts.jpg"
              alt="מסך לקוח ראשי ב-Plan-T: תשואת התיק, מאזן נכסים ותזרים הכנסות, פילוח נכסים, תיק פנסיוני וסיכונים וחשיפות"
              width="1344"
              height="1570"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- Pain → the Plan-T way -->
  <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="pain-title">
    <h2 id="pain-title" class="text-center text-3xl font-black text-ink-900">
      מכירים את זה מהמשרד שלכם?
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        painCards.map((card, i) => (
          <article
            class:list={[
              'reveal rounded-2xl border p-6 shadow-sm',
              i === 2 ? 'border-ink-700 bg-brand-700 text-white' : 'border-brand-100 bg-white',
            ]}
          >
            <h3 class="text-xl font-bold">{card.title}</h3>
            <p class:list={['mt-3 leading-relaxed', i === 2 ? 'text-ink-200' : 'text-ink-700']}>{card.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Plan-t AI capabilities -->
  <section class="bg-white py-16" aria-labelledby="ai-title">
    <div class="mx-auto max-w-6xl px-4">
      <h2 id="ai-title" class="text-center text-3xl font-black text-ink-900">
        מה <span class="ltr">Plan-t AI</span> עושה בשבילכם
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-ink-700">
        עוזר חכם בתוך הפלטפורמה — עם שקיפות מלאה ואישור אנושי בכל שלב. בלי הבטחות באוויר.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          aiCards.map((card) => (
            <article class="reveal rounded-2xl border border-brand-100 bg-brand-50 p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-700" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M10 15V7m0 0c0-2.2 1.8-3.7 4.4-3.7 0 2.6-1.8 4-4.4 3.7Zm0 1.5c0-1.8-1.5-3-3.7-3 0 2.2 1.5 3 3.7 3Z" stroke="#fff" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </div>
              <h3 class="mt-4 text-lg font-bold text-ink-900">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-700">{card.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Product tour -->
  <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="tour-title">
    <h2 id="tour-title" class="text-center text-3xl font-black text-ink-900">סיור קצר במוצר</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {
        tour.map((item) => (
          <figure class="reveal">
            {item.formats ? (
              <picture>
                <source srcset={`${item.image}.webp`} type="image/webp" />
                <img
                  src={`${item.image}.jpg`}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                  class="w-full rounded-2xl border border-brand-100 shadow-md"
                />
              </picture>
            ) : (
              <img
                src={item.image}
                alt={item.alt}
                width="640"
                height="400"
                loading="lazy"
                decoding="async"
                class="w-full rounded-2xl border border-brand-100 shadow-md"
              />
            )}
            <figcaption class="mt-3 text-center text-sm font-medium text-ink-700">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- Social proof — one real, published testimonial from plan-t.org.il.
       Wording and punctuation are verbatim; only whitespace was normalised
       (the editor's stray non-breaking spaces and doubled spaces collapsed),
       and CRM is wrapped in .ltr like every other Latin string on the site.
       Do not reword, and add nothing that is not published. -->
  <section class="bg-brand-50 py-16" aria-labelledby="proof-title">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h2 id="proof-title" class="text-3xl font-black text-ink-900">משרדים שכבר עובדים איתנו</h2>
      <figure class="reveal mt-8 rounded-2xl border border-brand-100 bg-white p-8 shadow-sm sm:p-10">
        <blockquote class="text-lg leading-relaxed text-ink-900 sm:text-xl">"סוף סוף מערכת שמרכזת הכל במקום אחד , <span class="ltr">CRM</span> :דוחות ללקוחות, ניהול חשיפות, תכנון פיננסי, תפעול ובקרה, – בלי קפיצות בין מערכות ובלי בזבוז זמן מיותר."</blockquote>
        <figcaption class="mt-6 text-sm font-bold text-brand-700">רווית, סוכנת ביטוח ופיננסים עצמאית</figcaption>
      </figure>
    </div>
  </section>

  <WebinarStrip />

  <LeadForm source="website-home" />
</BaseLayout>
