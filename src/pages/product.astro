---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import IconTile from '../components/IconTile.astro';
import LeadForm from '../components/LeadForm.astro';
import { advantages } from '../data/advantages';
import { modules } from '../data/modules';
---

<BaseLayout
  title="הפלטפורמה | Plan-T"
  description="Plan-T מרכזת במקום אחד את נתוני הנכסים הפיננסיים והפנסיוניים של הלקוח ושל התא המשפחתי, ומאפשרת לאנשי המקצוע לקבל תמונה רחבה של החשיפות והקצאת הנכסים."
>
  <!-- Same duotone treatment the mood imagery already uses elsewhere on the
       site: the photograph sits under a white wash so the type keeps its
       contrast. Decorative — empty alt, aria-hidden — because it carries
       nothing the copy does not already say. -->
  <PageHero size="compact" seed={2} cta={{ label: 'תיאום הדגמה', href: '#lead-form' }}>
    <Fragment slot="title">הפלטפורמה</Fragment>
    <Fragment slot="lead">
      <span class="ltr">Plan-T</span> מרכזת במקום אחד את נתוני הנכסים הפיננסיים והפנסיוניים של
      הלקוח ושל התא המשפחתי, ומציגה תמונה רחבה של החשיפות והקצאת הנכסים.
    </Fragment>
  </PageHero>

  <section class="band bg-white" aria-labelledby="consolidation-title">
    <div class="mx-auto max-w-3xl px-4">
    <h2 id="consolidation-title" class="reveal-lines text-3xl font-bold text-brand-800">מידע מרוכז. תמונה רחבה.</h2>
    <p class="mt-4 leading-relaxed text-ink-700">
      המידע הפיננסי והפנסיוני מפוזר בין מערכות ומקורות שונים. <span class="ltr">Plan-T</span> מרכזת
      אותו במקום אחד, כך שאפשר לבחון את התיק ואת החשיפות בצורה ברורה ומסודרת.
    </p>
    </div>
  </section>

  <section class="band bg-surface-blue" aria-labelledby="advantages-title">
    <div class="mx-auto max-w-3xl px-4">
      <h2 id="advantages-title" class="reveal-lines text-3xl font-bold text-brand-800">היתרונות המרכזיים</h2>
      <ul class="mt-6 space-y-3">
        {
          advantages.map((item) => (
            <li class="reveal card-lift flex gap-3 rounded-xl bg-white p-4 shadow-sm">
              <span class="mt-1 text-brand-600" aria-hidden="true">✓</span>
              <span class="text-ink-700">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- "המודולים": the eight modules from the old site's Home, migrated verbatim
       (src/data/modules.ts). Icons are decision N-7, deferred — each card keeps an
       empty, reserved slot rather than a placeholder image, so nothing is
       invented and the layout does not shift when the icons land. -->
  <section id="modules" class="band bg-white scroll-mt-24" aria-labelledby="modules-title">
    <div class="mx-auto max-w-6xl px-4">
      <h2 id="modules-title" class="reveal-lines text-center text-3xl font-bold text-brand-800">המודולים</h2>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          modules.map((item) => (
            <li class="reveal reveal--float card-lift rounded-2xl border border-brand-200 bg-white hover:border-brand-400 p-5 shadow-sm">
              <IconTile icon={item.icon} />
              <h3 class="mt-3 text-lg font-bold text-brand-800">{item.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-700">{item.line}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <LeadForm source="website-product" heading="רוצים לראות את הפלטפורמה בפעולה?" />
</BaseLayout>
