---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';

/*
  One audience — financial planners. The three stages replace the old
  role split; every line inside them is existing, verified site copy.
*/
const stages = [
  {
    id: 'before',
    title: 'לפני הפגישה',
    points: [
      'תמונת תיק אחת: השקעות, חיסכון וכיסויים במקום אחד.',
      'הכנה לפגישה בדקות במקום בשעות.',
      'ריכוז נתוני המסלקה לצד שאר המידע בתיק.',
    ],
  },
  {
    id: 'during',
    title: 'במהלך התכנון',
    points: [
      'בחינת התיק והחשיפות בצורה ברורה ומסודרת.',
      'השוואה ברורה בין חלופות להצגה מול הלקוח.',
    ],
  },
  {
    id: 'after',
    title: 'לאחר הפגישה',
    points: [
      'דוח מסודר ללקוח בסוף התהליך, ממותג במיתוג המשרד.',
      'תיעוד מלא של התהליך לצורכי רגולציה ובקרה.',
    ],
  },
];
---

<BaseLayout
  title="תהליכי עבודה עם Plan-T | Plan-T"
  description="איך Plan-T מלווה את תהליך העבודה — מהכנה לפגישה ועד הדוח ללקוח."
>
  <section class="bg-ink-900 text-white">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center">
      <h1 class="text-4xl font-bold md:text-5xl">תהליכי עבודה עם <span class="ltr">Plan-T</span></h1>
      <p class="mt-5 text-lg text-ink-200">
        מהכנה לפגישה ועד הדוח ללקוח — כך Plan-T מלווה את העבודה השוטפת.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 py-16">
    {
      stages.map((stage, index) => (
        <section id={stage.id} class:list={['reveal scroll-mt-24 py-10', index > 0 && 'border-t border-brand-100']} aria-labelledby={`${stage.id}-title`}>
          <h2 id={`${stage.id}-title`} class="text-3xl font-bold text-ink-900">{stage.title}</h2>
          <ul class="mt-6 grid gap-4 md:grid-cols-3">
            {stage.points.map((point) => (
              <li class="card-lift rounded-2xl border border-brand-100 bg-white p-5 text-sm leading-relaxed text-ink-700 shadow-sm">
                {point}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <LeadForm source="website-solutions" heading="נדבר על תהליך העבודה שלכם?" />
</BaseLayout>
