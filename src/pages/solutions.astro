---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';

/*
  Named, linkable capability grid (Orion-concept structure, no new claims).

  Every sentence below is the line that was already live on this page; the
  names are drawn from those sentences, not invented. Each card carries a
  stable id — solutions-<slug> — so other pages can point at one capability.
  The three timeline headings are untouched.

  Icons: 24×24 stroke glyphs, currentColor at ink-600, inside a fixed 40×40
  box so nothing shifts while they paint. §5.5 rule 5 puts the default at
  "skip"; these earn their slot as a scanning aid for seven cards that were
  an unlabelled list, and nothing more — no text inside them (rule 4), no
  green surface (rule 2), no meaning beyond the sentence beside them.
*/
interface Capability {
  slug: string;
  name: string;
  line: string;
  /** SVG path data; one simple concept per glyph. */
  icon: string;
}

interface Stage {
  id: string;
  title: string;
  items: Capability[];
}

const stages: Stage[] = [
  {
    id: 'before',
    title: 'לפני הפגישה',
    items: [
      {
        slug: 'portfolio-picture',
        name: 'תמונת תיק אחת',
        line: 'תמונת תיק אחת: השקעות, חיסכון וכיסויים במקום אחד.',
        icon: 'M12 3 3 8l9 5 9-5-9-5Zm-9 9 9 5 9-5m-18 4 9 5 9-5',
      },
      {
        slug: 'fast-prep',
        name: 'הכנה מהירה לפגישה',
        line: 'הכנה לפגישה בדקות במקום בשעות.',
        icon: 'M12 7v5l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
      },
      {
        slug: 'clearinghouse-data',
        name: 'נתוני מסלקה במקום אחד',
        line: 'ריכוז נתוני המסלקה לצד שאר המידע בתיק.',
        icon: 'M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3Zm0 0v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7m-16 5c0 1.7 3.6 3 8 3s8-1.3 8-3',
      },
    ],
  },
  {
    id: 'during',
    title: 'במהלך התכנון',
    items: [
      {
        slug: 'exposures',
        name: 'בחינת חשיפות',
        line: 'בחינת התיק והחשיפות בצורה ברורה ומסודרת.',
        icon: 'M4 20V10m6 10V4m6 16v-7m-14 7h18',
      },
      {
        slug: 'alternatives',
        name: 'השוואת חלופות',
        line: 'השוואה ברורה בין חלופות להצגה מול הלקוח.',
        icon: 'M12 4v16M4 8l4-3 4 3M12 8l4-3 4 3M4 8v6a4 4 0 0 0 8 0V8m0 0v6a4 4 0 0 0 8 0V8',
      },
    ],
  },
  {
    id: 'after',
    title: 'לאחר הפגישה',
    items: [
      {
        slug: 'branded-report',
        name: 'דוח ממותג ללקוח',
        line: 'דוח מסודר ללקוח בסוף התהליך, ממותג במיתוג המשרד.',
        icon: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Zm0 0v5h5M9 13h6m-6 4h6',
      },
      {
        slug: 'compliance-record',
        name: 'תיעוד לרגולציה ובקרה',
        line: 'תיעוד מלא של התהליך לצורכי רגולציה ובקרה.',
        icon: 'M4 8V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2M4 8h16v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8Zm6 4h4',
      },
    ],
  },
];

/*
  מקורות מידע — one entry, gated. This is the מסלקה bullet restated, not a
  new claim. Every other source Orion lists has no confirmed Plan-T
  equivalent yet (F-1); see the TODO under the section.
*/
const sources = [
  {
    slug: 'clearinghouse',
    name: 'מסלקה פנסיונית',
    line: 'נתוני המסלקה נטענים למערכת ומוצגים לצד שאר התיק — כך שאין צורך לעבור בין מקורות בזמן ההכנה לפגישה.',
    icon: 'M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3m-9 0h12v4a6 6 0 0 1-12 0V7Zm6 10v4',
  },
];
---

<BaseLayout
  title="תהליכי עבודה עם Plan-T | Plan-T"
  description="איך Plan-T מלווה את תהליך העבודה — מהכנה לפגישה ועד הדוח ללקוח."
>
  <!-- TODO: a short footnoted proof stat (e.g. "X hours saved per week") could sit here once Natali approves a real, sourced figure. Do not fill with an estimate. -->
  <section class="bg-gradient-to-b from-white to-brand-100 text-ink-900">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center">
      <h1 class="text-4xl font-bold md:text-5xl">תהליכי עבודה עם <span class="ltr">Plan-T</span></h1>
      <p class="mt-5 text-lg text-ink-700">
        מהכנה לפגישה ועד הדוח ללקוח — כך <span class="ltr">Plan-T</span> מלווה את העבודה השוטפת.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 py-16">
    {
      stages.map((stage, index) => (
        <section id={stage.id} class:list={['reveal scroll-mt-24 py-10', index > 0 && 'border-t border-brand-100']} aria-labelledby={`${stage.id}-title`}>
          <h2 id={`${stage.id}-title`} class="text-3xl font-bold text-brand-800">{stage.title}</h2>
          <ul class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {stage.items.map((item) => (
              <li
                id={`solutions-${item.slug}`}
                class="reveal card-lift scroll-mt-24 rounded-2xl border border-brand-200 bg-white hover:border-brand-400 p-5 shadow-sm"
              >
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100 text-brand-600" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d={item.icon} />
                  </svg>
                </div>
                <h3 class="mt-3 text-lg font-bold text-brand-800">{item.name}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-700">{item.line}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section id="sources" class="reveal scroll-mt-24 border-t border-brand-100 py-10" aria-labelledby="sources-title">
      <h2 id="sources-title" class="text-2xl font-bold text-brand-800">מקורות מידע שמתחברים ל-<span class="ltr">Plan-T</span></h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          sources.map((source) => (
            <li
              id={`solutions-source-${source.slug}`}
              class="reveal card-lift scroll-mt-24 rounded-2xl border border-brand-200 bg-white hover:border-brand-400 p-5 shadow-sm"
            >
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100 text-brand-600" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d={source.icon} />
                </svg>
              </div>
              <h3 class="mt-3 text-lg font-bold text-brand-800">{source.name}</h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-700">{source.line}</p>
            </li>
          ))
        }
      </ul>
      <!-- TODO(F-1): additional data-source cards pending Natali's confirmation of which sources are live. Do not add without approval. -->
    </section>
  </div>

  <LeadForm source="website-solutions" heading="נדבר על תהליך העבודה שלכם?" />
</BaseLayout>
